{
  "schema_version": "command-model-mutation-matrix/v1",
  "baseline_commit": "ba6f3aee4f0fcd941d9fa37135af0ce09ffdfa5c",
  "evidence_policy": "Entries are traced from the named Go mutation functions and model builders, not inferred from product design documents.",
  "product_scope": {
    "source": "internal/gateway/commandcatalog/catalog.go Availability.Enabled plus production Participant handlers",
    "enabled_public_commands_covered": [
      "JOIN_FARM",
      "GET_PLAYER_BOOTSTRAP",
      "GET_OPERATION_RESULT",
      "GET_TASK_LIST",
      "CLAIM_TASK",
      "CONFIRM_FRIEND_VISIT",
      "BUY",
      "SELL",
      "UNLOCK_PLOT",
      "PLANT",
      "HARVEST",
      "CARE",
      "THEFT"
    ],
    "controller_gate": "Hero/Task composition remains a Controller decision; this matrix records current code and does not approve that composition."
  },
  "current_layout": {
    "authority_layout_version": "v1",
    "redis_actor_schema_version": "2",
    "write_amplification_rule": "Every changed Actor commit rebuilds and rewrites the complete current ModelState and appends one outer Authority receipt. Rejected/no-change Participant terminals also write when they append an embedded durable receipt.",
    "stable_commit_metric_label": [
      "AR1_RECORD_COMMIT",
      "AR1_INITIAL_INSTALL"
    ],
    "business_command_label_available_at_store": false
  },
  "model_map": {
    "player": [
      {
        "field": "record",
        "encoding": "deterministic protobuf player.PlayerRecord",
        "role": "authoritative aggregate",
        "logical_contents": [
          "player_id",
          "economy_version",
          "bootstrap_id",
          "wallet",
          "inventory",
          "progression",
          "recent_operation_receipts",
          "item_reservations",
          "codex_entries",
          "legacy tasks",
          "task_domain_state",
          "public_profile",
          "unlock_coin_reservations"
        ],
        "write_evidence": "internal/player/actor/profile_projection.go:buildPlayerAuthorityModelState",
        "schema_evidence": "api/proto/player/player.proto:PlayerRecord"
      },
      {
        "field": "public_profile",
        "encoding": "publicprofile fixed deterministic projection encoding",
        "role": "derived read model; never business adjudication truth",
        "source_record_fields": [
          "player_id",
          "public_profile.display_name",
          "public_profile.avatar_id",
          "progression.level"
        ],
        "write_evidence": "internal/player/actor/profile_projection.go:PublicProfileProjection/buildPlayerAuthorityModelState"
      }
    ],
    "farm": [
      {
        "field": "record",
        "encoding": "deterministic protobuf farm.FarmRecord",
        "role": "authoritative aggregate",
        "logical_contents": [
          "farm_id",
          "core.farm_version",
          "core.plots",
          "core.crop_cycles",
          "recent_operation_receipts",
          "active_settlements",
          "recent_theft_attempts",
          "recent_care_attempts"
        ],
        "write_evidence": "internal/farm/actor/opportunity_models.go:buildFarmAuthorityModelState",
        "schema_evidence": "api/proto/farm/farm.proto:FarmRecord"
      },
      {
        "field": "opportunity_header",
        "encoding": "fixed-width deterministic binary",
        "role": "derived read model; never business adjudication truth",
        "write_evidence": "internal/farm/actor/opportunity_models.go:deriveFarmOpportunityModels/buildFarmAuthorityModelState"
      },
      {
        "field": "opportunity_facts",
        "encoding": "bounded deterministic binary",
        "role": "derived read model; never business adjudication truth",
        "write_evidence": "internal/farm/actor/opportunity_models.go:deriveFarmOpportunityModels/buildFarmAuthorityModelState"
      }
    ],
    "outer_authority_receipt": {
      "cardinality": "one appended for every new Authority Commit",
      "encoding": "Redis payload hash plus six length-prefixed fields",
      "evidence": "internal/storage/redis/authority/store.go:redisReceiptValueBytes and internal/storage/redis/authority/scripts.go:luaCommitActorWithOrdersSrc"
    },
    "source_order": {
      "current_actor_product_writer": "Farm CARE success only",
      "encoding": "separate SourceOrder Redis hash atomically created by the same Authority Commit Lua call",
      "evidence": "internal/farm/actor/care.go:buildCareRewardOrder/ResolveCareIncident"
    }
  },
