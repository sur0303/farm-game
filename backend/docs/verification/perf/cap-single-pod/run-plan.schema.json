{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-farm.invalid/schemas/cap-single-pod-l2-run-plan-v0.1.json",
  "title": "CAP-SINGLE-POD-L2 generic run plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "service", "profile", "phase", "tier",
    "duration_seconds", "ramp_seconds", "targets", "maximum_launch_lag_ms",
    "maximum_inflight", "driver_url", "driver_health_url", "snapshot_url",
    "collector_health_url", "oracle_url", "oracle_health_url", "collector_config_sha256",
    "oracle_config_sha256", "driver_binary_sha256", "manifest_path", "manifest_schema_path",
    "binding_path", "contract_path", "required_metrics_path", "stop_conditions_path",
    "verdict_rules_path", "environment_validity_path", "profile_path", "load_generator_qualification_path",
    "sample_interval_ms", "request_timeout_ms", "allowed_error_codes"
  ],
  "properties": {
    "schema_version": {"const": "cap-single-pod-l2.run-plan.v0.1"},
    "run_id": {"type": "string", "pattern": "^capsingle-l2-r[12]-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
    "service": {"enum": ["gate", "player", "farm", "worker"]},
    "profile": {"type": "string", "minLength": 1, "maxLength": 96},
    "phase": {"enum": ["PRECHECK", "OBSERVABILITY_QUALIFICATION", "LOAD_GENERATOR_QUALIFICATION", "SMOKE", "WARMUP", "STAIRCASE", "SAFE_TIER_CANDIDATE", "FORMAL_1", "COOLDOWN_1", "FORMAL_2", "COOLDOWN_2", "FORMAL_3", "INDEPENDENT_REVIEW"]},
    "tier": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "integer", "minimum": 1},
    "ramp_seconds": {"type": "integer", "minimum": 0},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
    "maximum_launch_lag_ms": {"const": 50},
    "maximum_inflight": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "driver_url": {"$ref": "#/$defs/loopbackURL"},
    "driver_health_url": {"$ref": "#/$defs/loopbackURL"},
    "snapshot_url": {"$ref": "#/$defs/loopbackURL"},
    "collector_health_url": {"$ref": "#/$defs/loopbackURL"},
    "oracle_url": {"$ref": "#/$defs/loopbackURL"},
    "oracle_health_url": {"$ref": "#/$defs/loopbackURL"},
    "collector_config_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_config_sha256": {"$ref": "#/$defs/sha256"},
    "driver_binary_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_path": {"$ref": "#/$defs/absolutePath"},
    "manifest_schema_path": {"$ref": "#/$defs/absolutePath"},
    "binding_path": {"$ref": "#/$defs/absolutePath"},
    "contract_path": {"$ref": "#/$defs/absolutePath"},
    "required_metrics_path": {"$ref": "#/$defs/absolutePath"},
    "stop_conditions_path": {"$ref": "#/$defs/absolutePath"},
    "verdict_rules_path": {"$ref": "#/$defs/absolutePath"},
    "environment_validity_path": {"$ref": "#/$defs/absolutePath"},
    "profile_path": {"$ref": "#/$defs/absolutePath"},
    "load_generator_qualification_path": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/absolutePath"}
      ],
      "description": "Null only for PRECHECK, OBSERVABILITY_QUALIFICATION, and LOAD_GENERATOR_QUALIFICATION. Absolute existing qualification evidence directory required for SMOKE and later capacity phases."
    },
    "sample_interval_ms": {"type": "integer", "minimum": 100, "maximum": 5000},
    "request_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
    "allowed_error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]{1,96}$"}},
    "metadata": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 256}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "loopbackURL": {"type": "string", "pattern": "^http://(127(?:\\.[0-9]{1,3}){3}|localhost|\\[::1\\]):[0-9]{1,5}/[^?#]*$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["connections", "arrivals_per_second", "frames_per_second", "egress_bytes_per_second", "handshakes_per_second", "active_actors", "subscriptions", "fanout_per_second", "backlog", "work_steps_per_second", "due_claims_per_second"]},
        "value": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
