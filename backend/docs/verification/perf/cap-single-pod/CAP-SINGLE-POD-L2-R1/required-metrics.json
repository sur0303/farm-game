{
  "schema_version": "cap-single-pod-l2-r1.required-metrics.v0.1",
  "policy": {
    "availability": "PRECHECK_REQUIRED",
    "missing_required_metric_verdict": "INCONCLUSIVE_OBSERVABILITY",
    "allow_log_estimation_for_required_metric": false,
    "allow_primitive_substitution": false,
    "sample_interval_seconds": 1,
    "maximum_scrape_gap_seconds": 5,
    "counter_reset_must_be_detected": true
  },
  "common": [
    {"name": "planned_arrivals_total", "type": "counter", "source": "load_generator"},
    {"name": "launched_arrivals_total", "type": "counter", "source": "load_generator"},
    {"name": "scheduled_unsent_total", "type": "counter", "source": "load_generator"},
    {"name": "completed_total", "type": "counter", "source": "load_generator"},
    {"name": "rejected_total", "type": "counter", "source": "load_generator"},
    {"name": "timeout_total", "type": "counter", "source": "load_generator"},
    {"name": "arrival_lag_ms", "type": "histogram", "source": "load_generator", "quantiles": [0.5, 0.95, 0.99, 1.0]},
    {"name": "driver_cpu_percent", "type": "gauge", "source": "cgroup"},
    {"name": "driver_rss_bytes", "type": "gauge", "source": "cgroup"},
    {"name": "driver_fd_open", "type": "gauge", "source": "procfs"},
    {"name": "driver_network_rx_bytes_total", "type": "counter", "source": "cgroup_or_procfs"},
    {"name": "driver_network_tx_bytes_total", "type": "counter", "source": "cgroup_or_procfs"},
    {"name": "driver_frame_encode_total", "type": "counter", "source": "load_generator"},
    {"name": "driver_frame_decode_total", "type": "counter", "source": "load_generator"},
    {"name": "driver_event_backlog", "type": "gauge", "source": "load_generator"},
    {"name": "service_cpu_percent", "type": "gauge", "source": "cgroup"},
    {"name": "service_rss_bytes", "type": "gauge", "source": "cgroup"},
    {"name": "service_heap_bytes", "type": "gauge", "source": "go_runtime"},
    {"name": "service_gc_pause_seconds", "type": "histogram", "source": "go_runtime"},
    {"name": "service_goroutines", "type": "gauge", "source": "go_runtime"},
    {"name": "service_fd_open", "type": "gauge", "source": "procfs"},
    {"name": "service_network_rx_bytes_total", "type": "counter", "source": "cgroup_or_procfs"},
    {"name": "service_network_tx_bytes_total", "type": "counter", "source": "cgroup_or_procfs"},
    {"name": "redis_commands_total", "type": "counter", "source": "redis_and_client_hook"},
    {"name": "redis_request_bytes_total", "type": "counter", "source": "redis_client_hook"},
    {"name": "redis_response_bytes_total", "type": "counter", "source": "redis_client_hook"},
    {"name": "redis_pool_wait_seconds", "type": "histogram", "source": "redis_client"},
    {"name": "redis_cpu_seconds_total", "type": "counter", "source": "redis_info"},
    {"name": "request_or_turn_latency_seconds", "type": "histogram", "source": "measured_service", "quantiles": [0.5, 0.95, 0.99]}
  ],
  "gate": [
    {"name": "active_connections", "type": "gauge"},
    {"name": "handshake_total", "type": "counter"},
    {"name": "handshake_latency_seconds", "type": "histogram"},
    {"name": "frames_in_total", "type": "counter"},
    {"name": "frames_out_total", "type": "counter"},
    {"name": "egress_bytes_total", "type": "counter"},
    {"name": "connection_writer_queue_items", "type": "gauge"},
    {"name": "connection_writer_queue_bytes", "type": "gauge"},
    {"name": "connection_writer_oldest_age_seconds", "type": "gauge"},
    {"name": "subscription_lane_depth", "type": "gauge"},
    {"name": "subscription_lane_oldest_age_seconds", "type": "gauge"},
    {"name": "slow_client_kick_total", "type": "counter"},
    {"name": "session_route_batch_items", "type": "histogram"},
    {"name": "session_route_batch_bytes", "type": "histogram"},
    {"name": "session_route_batch_duration_seconds", "type": "histogram"},
    {"name": "subscription_batch_items", "type": "histogram"},
    {"name": "subscription_batch_bytes", "type": "histogram"},
    {"name": "subscription_batch_duration_seconds", "type": "histogram"},
    {"name": "lease_deadline_remaining_seconds", "type": "histogram"}
  ],
  "player": [
    {"name": "player_active_actors", "type": "gauge"},
    {"name": "player_activation_total", "type": "counter"},
    {"name": "player_activation_latency_seconds", "type": "histogram"},
    {"name": "player_passivation_total", "type": "counter"},
    {"name": "player_mailbox_items", "type": "gauge"},
    {"name": "player_mailbox_bytes", "type": "gauge"},
    {"name": "player_mailbox_wait_seconds", "type": "histogram"},
    {"name": "player_turn_duration_seconds", "type": "histogram"},
    {"name": "player_load_and_claim_seconds", "type": "histogram"},
    {"name": "player_serialization_seconds", "type": "histogram"},
    {"name": "player_commit_seconds", "type": "histogram"},
    {"name": "player_commit_bytes_total", "type": "counter"},
    {"name": "player_actor_memory_bytes", "type": "histogram"},
    {"name": "player_participant_latency_seconds", "type": "histogram"}
  ],
  "farm": [
    {"name": "farm_active_actors", "type": "gauge"},
    {"name": "farm_activation_total", "type": "counter"},
    {"name": "farm_activation_latency_seconds", "type": "histogram"},
    {"name": "farm_passivation_total", "type": "counter"},
    {"name": "farm_mailbox_items", "type": "gauge"},
    {"name": "farm_mailbox_bytes", "type": "gauge"},
    {"name": "farm_mailbox_wait_seconds", "type": "histogram"},
    {"name": "farm_turn_duration_seconds", "type": "histogram"},
    {"name": "farm_load_and_claim_seconds", "type": "histogram"},
    {"name": "farm_serialization_seconds", "type": "histogram"},
    {"name": "farm_commit_seconds", "type": "histogram"},
    {"name": "farm_commit_bytes_total", "type": "counter"},
    {"name": "farm_actor_memory_bytes", "type": "histogram"},
    {"name": "farm_join_total", "type": "counter"},
    {"name": "farm_change_fanout_total", "type": "counter"},
    {"name": "farm_subscriptions", "type": "gauge"},
    {"name": "farm_version_ring_depth", "type": "gauge"}
  ],
  "worker": [
    {"name": "worker_due_depth", "type": "gauge"},
    {"name": "worker_oldest_due_age_seconds", "type": "gauge"},
    {"name": "worker_scan_duration_seconds", "type": "histogram"},
    {"name": "worker_claim_total", "type": "counter"},
    {"name": "worker_complete_total", "type": "counter"},
    {"name": "worker_retry_total", "type": "counter"},
    {"name": "worker_invalid_order_total", "type": "counter"},
    {"name": "worker_step_unknown_total", "type": "counter"},
    {"name": "worker_participant_latency_seconds", "type": "histogram"},
    {"name": "worker_backlog_drain_per_second", "type": "gauge"},
    {"name": "worker_due_depth_by_family", "type": "gauge", "required_labels": ["family"]},
    {"name": "worker_complete_total_by_family", "type": "counter", "required_labels": ["family"]}
  ],
  "correctness": [
    "duplicate_grant_total",
    "duplicate_debit_total",
    "stale_holder_commit_success_total",
    "farm_version_gap_total",
    "workflow_step_unknown_residual",
    "due_residual_unexpected",
    "h5_pending_journal_residual",
    "authority_client_mismatch_total",
    "silent_drop_total",
    "unexpected_lease_expiry_total",
    "friend_pair_index_unrepaired",
    "invalid_order_total",
    "wrong_scope_dispatch_total",
    "record_version_regression_total",
    "receipt_conflict_leak_total"
  ]
}
