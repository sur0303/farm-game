{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farm-game.invalid/r2-q/fixture-contracts.schema.json",
  "title": "R2-Q deterministic verification fixture contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "fixture_id", "contract_status", "deterministic", "production_semantics_changed", "cases"],
  "properties": {
    "schema": {"type": "string", "pattern": "^farm\\.r2-q\\.fixture/[^/]+/v[0-9]+$"},
    "fixture_id": {"type": "string", "minLength": 1},
    "contract_status": {"enum": ["SKIPPED_NOT_COMPOSED", "COMPOSED", "BLOCKED_ENVIRONMENT"]},
    "deterministic": {"const": true},
    "production_semantics_changed": {"const": false},
    "cases": {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}}
  }
}
