#!/usr/bin/env bash
# C0 smoke: isolated ephemeral Redis + real processes + fixture + friend-capacity
# workloads. Exact run-scoped cleanup on EXIT/INT/TERM. Never touches shared Redis.
# shellcheck shell=bash
set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-c0.sh
source "$script_dir/lib-c0.sh"

config_path="${1:-$c0_root/deploy/load/friend-opportunity-c0-smoke.json}"
[[ -f "$config_path" ]] || { printf 'missing config: %s\n' "$config_path" >&2; exit 2; }

run_id="${FARM_PERF_RUN_ID:-c0s$(date -u +%m%d%H%M%S%N)}"
run_id="$(printf '%s' "$run_id" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
namespace="foperf-${run_id}"
if (( ${#namespace} > 32 )); then
  printf 'namespace %s exceeds rediskey 32-char limit\n' "$namespace" >&2
  exit 2
fi

evidence_root="${FARM_PERF_EVIDENCE_ROOT:-$c0_root/docs/verification/perf/friend-opportunity-c0/$run_id}"
state_dir="${FARM_PERF_STATE_DIR:-/tmp/farmgame-c0/$run_id}"
build_dir="${FARM_PERF_BUILD_DIR:-/tmp/farmgame-c0-build}"
if [[ -e "$evidence_root" || -e "$state_dir" ]]; then
  printf 'refusing run_id %s: evidence/state already exists\n' "$run_id" >&2
  exit 2
fi
mkdir -p "$evidence_root" "$state_dir" "$build_dir"

load_secret="c0-load-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
friend_count="$(python3 - "$config_path" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))["matrix"]["friend_counts"][0])
PY
)"
density="$(python3 - "$config_path" <<'PY'
import json,sys
print(json.load(open(sys.argv[1])).get("fixture",{}).get("density_percent",0))
PY
)"
read -r viewer target_owner fake_base cell_run_id < <(c0_cell_identities "$run_id" "$friend_count")
[[ -n "$cell_run_id" && "$cell_run_id" == "${run_id}f${friend_count}" ]] || {
  printf 'cell identity mismatch for smoke run_id=%s friend_count=%s\n' "$run_id" "$friend_count" >&2
  exit 2
}

cleanup_done=0
c0_cleanup() {
  local ec=$?
  if (( cleanup_done == 0 )); then
    cleanup_done=1
    c0_stack_down "$state_dir" || true
    cp -f "$state_dir/cleanup.json" "$evidence_root/cleanup.json" 2>/dev/null || \
      printf '{"cleanup":"destroy_exact_ephemeral_container_and_processes","completed":false}\n' >"$evidence_root/cleanup.json"
  fi
  exit "$ec"
}
trap c0_cleanup EXIT INT TERM

printf 'C0 smoke run_id=%s cell_run_id=%s namespace=%s viewer=%s target=%s evidence=%s\n' \
  "$run_id" "$cell_run_id" "$namespace" "$viewer" "$target_owner" "$evidence_root"
cp "$config_path" "$evidence_root/config.json"
printf '{"run_id":"%s","cell_run_id":"%s","namespace":"%s","zone":"local","hint_transport_effective":"direct","viewer":%s,"target_owner":%s,"friend_count":%s,"claims_30m_dau":false}\n' \
  "$run_id" "$cell_run_id" "$namespace" "$viewer" "$target_owner" "$friend_count" >"$evidence_root/run-meta.json"

c0_build_binaries "$build_dir"
c0_prepare_stack_identity "$state_dir" "$namespace" "$run_id"
redis_url="$(c0_redis_up "$run_id")"
c0_stack_up "$build_dir" "$state_dir" "$namespace" "$run_id" "$redis_url" "$load_secret"
# shellcheck disable=SC1090
source "$state_dir/stack.env"

c0_bootstrap_player() {
  local player_id=$1 bootstrap_tag=$2
  python3 - "$PERF_GATE_HTTP" "$load_secret" "$player_id" "$bootstrap_tag" <<'PY'
import hashlib, hmac, json, sys, urllib.request
base, secret, player, tag = sys.argv[1], sys.argv[2].encode(), sys.argv[3], sys.argv[4]
mac = hmac.new(secret, player.encode(), hashlib.sha256).hexdigest()
body = json.dumps({
  "platform_token": f"load:{player}:{mac}",
  "bootstrap_id": f"c0-bootstrap-{tag}-{player}",
  "client_build": "c0-smoke/1",
}).encode()
req = urllib.request.Request(base.rstrip("/") + "/api/v1/auth/login", data=body,
                             headers={"content-type": "application/json"})
with urllib.request.urlopen(req, timeout=30) as resp:
    payload = json.load(resp)
if str(payload.get("player_id")) != player:
    raise SystemExit(f"bootstrap identity mismatch: {payload!r}")
print(json.dumps(payload))
PY
}

# Bootstrap responses contain one-time connection tickets/session identifiers.
# They are needed only to initialize actors and must stay in the ephemeral
# state directory, which the exact-run cleanup removes.
c0_bootstrap_player "$viewer" "$cell_run_id" >"$state_dir/bootstrap-viewer-sensitive.json"
c0_bootstrap_player "$target_owner" "$cell_run_id" >"$state_dir/bootstrap-target-sensitive.json"

route_snapshot="$state_dir/route-snapshot.json"
FARM_REDIS_URL="$redis_url" REDIS_NAMESPACE_ENVIRONMENT="$namespace" REDIS_NAMESPACE_ZONE=local \
  FARM_PERF_RUN_ID="$cell_run_id" \
  "$build_dir/friend-opportunity-perf-fixture" \
    --viewer "$viewer" --target-owner "$target_owner" \
    --friend-count "$friend_count" --density "$density" \
    --player-addr "$PERF_PLAYER_ADDR" \
    --route "$route_snapshot" \
    --namespace-env "$namespace" --zone local --run-id "$cell_run_id" \
    --fake-base "$fake_base" \
  | tee "$evidence_root/fixture.json"

python3 - "$evidence_root/fixture.json" "$friend_count" "$viewer" "$target_owner" "$cell_run_id" <<'PY'
import json, sys
from pathlib import Path
path, want, viewer, target, cell_run = Path(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
data = json.loads(path.read_text())
if int(data.get("verified_friend_count") or 0) != want:
    raise SystemExit(f"roster cardinality mismatch: verified={data.get('verified_friend_count')} want={want}")
if int(data.get("viewer_player_id") or 0) != viewer or int(data.get("target_owner_id") or 0) != target:
    raise SystemExit(f"fixture identity mismatch: {data}")
if str(data.get("run_id") or "") != cell_run:
    raise SystemExit(f"fixture run_id mismatch: got={data.get('run_id')} want={cell_run}")
print(f"verified roster cardinality={want}")
PY

run_workload() {
  local scenario=$1 out=$2
  local before_dir="$evidence_root/metrics/before-${scenario}"
  local after_dir="$evidence_root/metrics/after-${scenario}"
  local aggregate_path="$evidence_root/redis-aggregate-${scenario}.json"
  local gate="fail"
  local extra=()
  if [[ "$scenario" == "hint" ]]; then
    extra+=(--hint-target-owner "$target_owner" --hint-loops 1 --hint-wait 12s)
  fi
  c0_scrape_participating "$before_dir"
  LOAD_TEST_TOKEN_SECRET="$load_secret" "$build_dir/ws-stress" \
    -http-url "$PERF_GATE_HTTP" -ws-url "$PERF_GATE_WS" \
    -conns 1 -rate 1 -duration 45s \
    -player-start "$viewer" -friend-viewer "$viewer" \
    -friend-count "$friend_count" -scenario "$scenario" \
    -environment isolated-ephemeral-redis \
    -run-id "$cell_run_id" \
    -json-out "$out" "${extra[@]}"
  c0_scrape_participating "$after_dir"
  c0_redis_workload_aggregate "$before_dir" "$after_dir" "$run_id" "$cell_run_id" "$scenario" >"$aggregate_path" || \
    printf '{"run_id":"%s","cell_run_id":"%s","scenario":"%s","interval":{"before":[],"after":[]},"commands":null,"bytes":null,"availability":"measurement_unavailable","endpoints":["gate:gate.prom","player:player.prom","farm:farm.prom","worker:worker.prom"],"scope":"workload_participating_services_incomplete"}\n' \
      "$run_id" "$cell_run_id" "$scenario" >"$aggregate_path"
  c0_merge_redis_evidence "$out" "$aggregate_path" \
    "$evidence_root/evidence-${scenario}.json" "$run_id" "$cell_run_id" "$scenario"
  gate=$(python3 - "$aggregate_path" <<'PY'
import json,sys
print(json.load(open(sys.argv[1])).get("availability","measurement_unavailable"))
PY
)
  if [[ "$gate" == "ok" ]]; then
    return 0
  else
    return 1
  fi
}

measurement_gate=pass
friend_list_status=pass
if ! run_workload friend-list "$evidence_root/workload-friend-list.json"; then
  friend_list_status=fail
  measurement_gate=fail
fi
if ! run_workload next-opportunity "$evidence_root/workload-next-opportunity.json"; then
  measurement_gate=fail
fi
if ! run_workload hint "$evidence_root/workload-hint.json"; then
  measurement_gate=fail
fi

python3 - "$evidence_root" "$measurement_gate" "$friend_list_status" "$run_id" "$namespace" "$cell_run_id" <<'PY'
import json, sys
from pathlib import Path
root = Path(sys.argv[1])
measurement_gate, friend_list_status = sys.argv[2], sys.argv[3]
run_id, namespace, cell_run_id = sys.argv[4], sys.argv[5], sys.argv[6]
workloads = {}
counting_ok = True
friend_list_ok = False
run_id_ok = True
for name in ("friend-list", "next-opportunity", "hint"):
    path = root / f"workload-{name}.json"
    data = json.loads(path.read_text())
    if str(data.get("run_id") or "") != cell_run_id:
        run_id_ok = False
    attempted = int(data.get("scenario_attempted") or 0)
    succeeded = int(data.get("scenario_succeeded") or 0)
    errors = int(data.get("scenario_errors") or 0)
    workloads[name] = {
        "scenario_attempted": attempted,
        "scenario_succeeded": succeeded,
        "scenario_errors": errors,
        "run_id": data.get("run_id"),
    }
    if attempted != 1 or succeeded + errors != 1 or succeeded > attempted:
        counting_ok = False
    if name == "friend-list":
        friend_list_ok = succeeded == 1 and errors == 0
    else:
        # next-opportunity/hint record explicit UNKNOWN/unavailable failure when
        # the production path returns FRIEND_OPPORTUNITY_TEMPORARILY_UNAVAILABLE;
        # that is honest evidence, not a gate failure.
        if succeeded not in (0, 1) or errors not in (0, 1) or succeeded + errors != 1:
            counting_ok = False
    evidence = json.loads((root / f"evidence-{name}.json").read_text())
    friend = evidence.get("friend_capacity") or {}
    if not friend.get("server_phase_availability"):
        counting_ok = False
    if str(evidence.get("run_id") or "") != run_id:
        run_id_ok = False
    if str(evidence.get("cell_run_id") or "") != cell_run_id:
        run_id_ok = False
    if str(evidence.get("scenario") or "") != name:
        counting_ok = False
    bound = evidence.get("redis_evidence_bound") or {}
    if bound.get("run_id") != run_id or bound.get("cell_run_id") != cell_run_id or bound.get("scenario") != name:
        counting_ok = False
    endpoints = evidence.get("redis_evidence_endpoints")
    if endpoints is None:
        endpoints = friend.get("redis_evidence_endpoints")
    if endpoints is None:
        counting_ok = False
    if evidence.get("redis_measurement_gate") != "pass":
        measurement_gate = "fail"
scenario_ok = counting_ok and friend_list_ok and run_id_ok
verdict = "pass" if measurement_gate == "pass" and friend_list_status == "pass" and scenario_ok else "fail"
(root / "verdict.json").write_text(json.dumps({
    "run_id": run_id,
    "cell_run_id": cell_run_id,
    "namespace": namespace,
    "hint_transport_effective": "direct",
    "redis_measurement_gate": measurement_gate,
    "friend_list_status": friend_list_status,
    "scenario_gate": "pass" if scenario_ok else "fail",
    "workloads": workloads,
    "verdict": verdict,
    "notes": [
        "C0 smoke does not claim 30M DAU equivalence.",
        "Redis deltas are workload-scoped aggregates across gate/player/farm/worker.",
        "Server-side phases not instrumented in production appear as measurement_unavailable.",
        "next-opportunity/hint may record explicit unavailable when the production read returns UNKNOWN; that is honest evidence, not a gate failure.",
        "friend-list must succeed; any friend-list scenario error fails the verdict.",
    ],
}, indent=2) + "\n")
raise SystemExit(0 if verdict == "pass" else 1)
PY
