#!/usr/bin/env bash
# Run one synchronized Kubernetes capacity step against the dedicated QQ Farm
# namespace. The script owns only Jobs whose exact names it records and never
# mutates Runtime workloads, Redis data outside the supplied player range, or
# another run's evidence directory.
set -Eeuo pipefail

usage() {
  cat <<'EOF'
usage: run-qqfarm-live-capacity-step MODE TOTAL PLAYER_START LABEL SHARDS ARRIVAL_RATE [SESSION] [THINK]

MODE          join | journey | theft
TOTAL         total bots; must be divisible by SHARDS
PLAYER_START  first unique load-test player id
LABEL         lowercase run label used for Jobs and evidence
SHARDS        number of synchronized load-generator Jobs
ARRIVAL_RATE  aggregate bot arrivals per second
SESSION       online session duration; 0s means one-shot (default 0s)
THINK         delay between online actions (default 5s)

Environment overrides:
  KUBE_CONTEXT=uc-test-plus
  NAMESPACE=developer_026-qqfarm
  BOT_IMAGE=<immutable image reference>
  OUT_ROOT=/data/home/developer_026/load-results/capacity-20260825
  RUN_DURATION=20m
  RUN_TIMEOUT_SECONDS=1800
  ACTION_WARMUP=0s
  BUSINESS_WARMUP=0s
  UNLOCK_PLOTS=0|1
  UNLOCK_PLOT_LIMIT=19
  UNLOCK_CONCURRENCY=4
  SESSION_ACTIONS=0
  FIXTURE_PLAYERS=0|1
  FIXTURE_COINS=50000
  FIXTURE_LEVEL=19
  FIXTURE_CONCURRENCY=64
  FRIEND_RING=0|1
  FRIEND_RING_OFFSET=1
EOF
}

(( $# >= 6 && $# <= 8 )) || { usage >&2; exit 2; }
MODE=$1
TOTAL=$2
PLAYER_START=$3
LABEL=$4
SHARDS=$5
AGGREGATE_RATE=$6
SESSION=${7:-0s}
THINK=${8:-5s}

case "$MODE" in join|journey|theft) ;; *) echo "invalid MODE: $MODE" >&2; exit 2;; esac
[[ "$TOTAL" =~ ^[1-9][0-9]*$ && "$PLAYER_START" =~ ^[1-9][0-9]*$ && "$SHARDS" =~ ^[1-9][0-9]*$ ]] || {
  echo "TOTAL, PLAYER_START and SHARDS must be positive integers" >&2; exit 2; }
[[ "$AGGREGATE_RATE" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ARRIVAL_RATE must be positive" >&2; exit 2; }
[[ "$LABEL" =~ ^[a-z0-9][a-z0-9-]{2,47}$ ]] || { echo "unsafe LABEL: $LABEL" >&2; exit 2; }
(( TOTAL % SHARDS == 0 )) || { echo "TOTAL must be divisible by SHARDS" >&2; exit 2; }

CTX=${KUBE_CONTEXT:-uc-test-plus}
NS=${NAMESPACE:-developer_026-qqfarm}
BOT_IMAGE=${BOT_IMAGE:-mirrors.tencent.com/uc-backend/farm-live-bot@sha256:d3ae9cb0c9083f448195b37d4c16189f9bf4fbf7dd5052ff1686530cb287aad1}
OUT_ROOT=${OUT_ROOT:-/data/home/developer_026/load-results/capacity-20260825}
RUN_DURATION=${RUN_DURATION:-20m}
RUN_TIMEOUT_SECONDS=${RUN_TIMEOUT_SECONDS:-1800}
ACTION_WARMUP=${ACTION_WARMUP:-0s}
BUSINESS_WARMUP=${BUSINESS_WARMUP:-0s}
UNLOCK_PLOTS=${UNLOCK_PLOTS:-0}
UNLOCK_PLOT_LIMIT=${UNLOCK_PLOT_LIMIT:-19}
UNLOCK_CONCURRENCY=${UNLOCK_CONCURRENCY:-4}
SESSION_ACTIONS=${SESSION_ACTIONS:-0}
FIXTURE_PLAYERS=${FIXTURE_PLAYERS:-0}
FIXTURE_COINS=${FIXTURE_COINS:-50000}
FIXTURE_LEVEL=${FIXTURE_LEVEL:-19}
FIXTURE_CONCURRENCY=${FIXTURE_CONCURRENCY:-64}
FRIEND_RING=${FRIEND_RING:-0}
FRIEND_RING_OFFSET=${FRIEND_RING_OFFSET:-1}
[[ "$UNLOCK_PLOTS" == 0 || "$UNLOCK_PLOTS" == 1 ]] || { echo "UNLOCK_PLOTS must be 0 or 1" >&2; exit 2; }
[[ "$UNLOCK_PLOT_LIMIT" =~ ^[0-9]+$ && "$UNLOCK_CONCURRENCY" =~ ^[0-9]+$ && "$SESSION_ACTIONS" =~ ^[0-9]+$ ]] || {
  echo "UNLOCK_PLOT_LIMIT, UNLOCK_CONCURRENCY and SESSION_ACTIONS must be non-negative integers" >&2; exit 2; }
[[ "$FIXTURE_PLAYERS" == 0 || "$FIXTURE_PLAYERS" == 1 ]] || { echo "FIXTURE_PLAYERS must be 0 or 1" >&2; exit 2; }
[[ "$FIXTURE_COINS" =~ ^[0-9]+$ && "$FIXTURE_LEVEL" =~ ^[1-9][0-9]*$ && "$FIXTURE_CONCURRENCY" =~ ^[1-9][0-9]*$ ]] || {
  echo "FIXTURE_COINS, FIXTURE_LEVEL and FIXTURE_CONCURRENCY are invalid" >&2; exit 2; }
[[ "$FRIEND_RING" == 0 || "$FRIEND_RING" == 1 ]] || { echo "FRIEND_RING must be 0 or 1" >&2; exit 2; }
if [[ "$MODE" == theft && "$FRIEND_RING" != 1 ]]; then
  echo "theft requires FRIEND_RING=1" >&2
  exit 2
fi

PER_SHARD=$((TOTAL / SHARDS))
RATE_PER_SHARD=$(python3 -c 'import sys; print(float(sys.argv[1])/int(sys.argv[2]))' "$AGGREGATE_RATE" "$SHARDS")
DIR="$OUT_ROOT/$LABEL"
[[ ! -e "$DIR" ]] || { echo "evidence directory already exists: $DIR" >&2; exit 2; }
mkdir -p "$DIR"
K=(kubectl --context "$CTX" -n "$NS")
JOBS=()
PODS=()
SAMPLER_PID=''
FIXTURE_JOB=''

# The fixture reads the durable route snapshot directly. Never rely on its
# developer defaults here: capacity runs may deliberately use an isolated
# Redis namespace/zone while the shared cluster keeps another runtime alive.
REDIS_NAMESPACE_ENVIRONMENT=${REDIS_NAMESPACE_ENVIRONMENT:-$("${K[@]}" get configmap farm-platform -o jsonpath='{.data.REDIS_NAMESPACE_ENVIRONMENT}')}
REDIS_NAMESPACE_ZONE=${REDIS_NAMESPACE_ZONE:-$("${K[@]}" get configmap farm-platform -o jsonpath='{.data.REDIS_NAMESPACE_ZONE}')}
[[ -n "$REDIS_NAMESPACE_ENVIRONMENT" && -n "$REDIS_NAMESPACE_ZONE" ]] || {
  echo "Redis namespace environment and zone are required" >&2
  exit 2
}

cleanup() {
  local code=$?
  set +e
  if [[ -n "$SAMPLER_PID" ]]; then
    kill "$SAMPLER_PID" >/dev/null 2>&1 || true
    wait "$SAMPLER_PID" >/dev/null 2>&1 || true
  fi
  for job in "${JOBS[@]:-}"; do
    "${K[@]}" delete job "$job" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  done
  if [[ -n "$FIXTURE_JOB" ]]; then
    "${K[@]}" delete job "$FIXTURE_JOB" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  fi
  exit "$code"
}
trap cleanup EXIT INT TERM
fail() { echo "ERROR: $*" >&2; exit 2; }

active=$("${K[@]}" get jobs -o jsonpath='{range .items[?(@.status.active>0)]}{.metadata.name}{"\n"}{end}')
[[ -z "$active" ]] || fail "another load Job is active: $active"
for pod in farm-gate-0 player-svr-0 farm-svr-0; do
  [[ $("${K[@]}" get pod "$pod" -o jsonpath='{.status.phase}') == Running ]] || fail "$pod is not Running"
  [[ $("${K[@]}" get pod "$pod" -o jsonpath='{.status.containerStatuses[0].ready}') == true ]] || fail "$pod is not Ready"
done

python3 - "$DIR/run-config.json" "$MODE" "$TOTAL" "$PLAYER_START" "$LABEL" "$SHARDS" "$AGGREGATE_RATE" "$SESSION" "$THINK" "$BOT_IMAGE" "$UNLOCK_PLOTS" "$UNLOCK_PLOT_LIMIT" "$UNLOCK_CONCURRENCY" "$SESSION_ACTIONS" "$FIXTURE_PLAYERS" "$FIXTURE_COINS" "$FIXTURE_LEVEL" "$FIXTURE_CONCURRENCY" "$REDIS_NAMESPACE_ENVIRONMENT" "$REDIS_NAMESPACE_ZONE" "$FRIEND_RING" "$FRIEND_RING_OFFSET" <<'PY'
import json,sys
path,mode,total,start,label,shards,rate,session,think,image,unlock,unlock_limit,unlock_concurrency,session_actions,fixture,fixture_coins,fixture_level,fixture_concurrency,redis_environment,redis_zone,friend_ring,friend_ring_offset=sys.argv[1:]
with open(path,'w') as out:
    json.dump({
        'mode':mode,'total_bots':int(total),'player_start':int(start),'label':label,
        'driver_shards':int(shards),'aggregate_arrival_rate':float(rate),
        'session_duration':session,'think_time':think,'driver_image':image,
        'unlock_plots':unlock == '1','unlock_plot_limit':int(unlock_limit),
        'unlock_concurrency':int(unlock_concurrency),'session_actions':int(session_actions),
        'fixture_players':fixture == '1','fixture_coins':int(fixture_coins),
        'fixture_level':int(fixture_level),'fixture_concurrency':int(fixture_concurrency),
        'redis_namespace_environment':redis_environment,'redis_namespace_zone':redis_zone,
        'friend_ring':friend_ring == '1','friend_ring_offset':int(friend_ring_offset),
    },out,indent=2,sort_keys=True)
    out.write('\n')
PY
"${K[@]}" get pods -o json > "$DIR/pods-before.json"
"${K[@]}" get sts farm-gate player-svr farm-svr -o json > "$DIR/runtime-before.json"

if [[ "$FIXTURE_PLAYERS" == 1 ]]; then
  fixture_job="cap-${LABEL}-fixture"
  fixture_job=${fixture_job:0:62}
  FIXTURE_JOB=$fixture_job
  "${K[@]}" apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: $fixture_job
  namespace: $NS
  labels:
    app.kubernetes.io/name: live-bot-fixture
    farm.io/load-step: $LABEL
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  ttlSecondsAfterFinished: 900
  template:
    metadata:
      labels:
        app: live-bot-fixture
        farm.io/load-step: $LABEL
    spec:
      priorityClassName: high-cpu-priority
      restartPolicy: Never
      imagePullSecrets:
        - name: uc-registry
      containers:
        - name: live-bot-fixture
          image: $BOT_IMAGE
          imagePullPolicy: IfNotPresent
          command: ["/usr/local/bin/live-bot-fixture"]
          args:
            - --player-start=$PLAYER_START
            - --players=$TOTAL
            - --coins=$FIXTURE_COINS
            - --level=$FIXTURE_LEVEL
            - --concurrency=$FIXTURE_CONCURRENCY
            - --timeout=12m
            - --namespace-env=$REDIS_NAMESPACE_ENVIRONMENT
            - --zone=$REDIS_NAMESPACE_ZONE
            - --friend-ring=$FRIEND_RING
            - --friend-ring-offset=$FRIEND_RING_OFFSET
          envFrom:
            - configMapRef:
                name: farm-platform
          env:
            - name: FARM_REDIS_URL
              valueFrom: {secretKeyRef: {name: farm-secrets, key: redis-url}}
            - name: FARM_AUTHORITY_REDIS_URL
              valueFrom: {secretKeyRef: {name: farm-secrets, key: authority-redis-url}}
            - name: FARM_RUNTIME_REDIS_URL
              valueFrom: {secretKeyRef: {name: farm-secrets, key: runtime-redis-url}}
            - name: FARM_PROJECTION_REDIS_URL
              valueFrom: {secretKeyRef: {name: farm-secrets, key: projection-redis-url}}
            - name: FARM_REDIS_CLUSTER
              value: "1"
            - name: FARM_REDIS_CLUSTER_URLS
              valueFrom: {configMapKeyRef: {name: farm-platform, key: FARM_REDIS_CLUSTER_URLS}}
          resources:
            requests: {cpu: "4", memory: 4Gi}
            limits: {cpu: "4", memory: 4Gi}
EOF
  fixture_pod=''
  for _ in $(seq 1 900); do
    fixture_pod=$("${K[@]}" get pod -l job-name="$fixture_job" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
    [[ -n "$fixture_pod" ]] || { sleep 1; continue; }
    phase=$("${K[@]}" get pod "$fixture_pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
    [[ "$phase" == Succeeded ]] && break
    [[ "$phase" != Failed ]] || break
    sleep 1
  done
  [[ -n "$fixture_pod" ]] || fail "fixture Pod was not created"
  "${K[@]}" logs "$fixture_pod" > "$DIR/fixture.log" 2>&1 || true
  [[ $("${K[@]}" get pod "$fixture_pod" -o jsonpath='{.status.phase}') == Succeeded ]] || fail "fixture failed; see $DIR/fixture.log"
  "${K[@]}" delete job "$fixture_job" --ignore-not-found --wait=false >/dev/null 2>&1 || true
  FIXTURE_JOB=''
fi

for index in $(seq 0 $((SHARDS - 1))); do
  start=$((PLAYER_START + index * PER_SHARD))
  job="cap-${LABEL}-s${index}"
  job=${job:0:62}
  run="${LABEL}-s${index}"
  JOBS+=("$job")
  session_args=''
  if [[ "$SESSION" != 0s ]]; then
    session_args="--session-duration=$SESSION --think-time=$THINK --action-warmup=$ACTION_WARMUP --business-warmup=$BUSINESS_WARMUP --session-actions=$SESSION_ACTIONS"
  fi
  unlock_args=''
  if [[ "$UNLOCK_PLOTS" == 1 ]]; then
    unlock_args="--unlock-plots --unlock-plot-limit=$UNLOCK_PLOT_LIMIT --unlock-concurrency=$UNLOCK_CONCURRENCY"
  fi
  ring_args=''
  if [[ "$FRIEND_RING" == 1 ]]; then
    ring_args="--friend-ring --friend-ring-start=$PLAYER_START --friend-ring-size=$TOTAL --friend-ring-offset=$FRIEND_RING_OFFSET"
  fi
  "${K[@]}" apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: $job
  namespace: $NS
  labels:
    app.kubernetes.io/name: live-farm-bot
    farm.io/load-step: $LABEL
spec:
  backoffLimit: 0
  activeDeadlineSeconds: $RUN_TIMEOUT_SECONDS
  ttlSecondsAfterFinished: 900
  template:
    metadata:
      labels:
        app: live-farm-bot
        farm.io/load-step: $LABEL
        farm.io/load-shard: "$index"
    spec:
      priorityClassName: high-cpu-priority
      restartPolicy: Never
      terminationGracePeriodSeconds: 30
      imagePullSecrets:
        - name: uc-registry
      containers:
        - name: live-farm-bot
          image: $BOT_IMAGE
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-ec"]
          args:
            - |
              while [ ! -f /tmp/start ]; do sleep 0.2; done
              set +e
              /usr/local/bin/live-farm-bot \
                --allow-non-loopback \
                --http-url=http://farm-gate:8080 \
                --ws-url=ws://farm-gate:8080/ws \
                --listen=127.0.0.1:18681 \
                --players=$PER_SHARD \
                --player-start=$start \
                --duration=$RUN_DURATION \
                --arrival-rate=$RATE_PER_SHARD \
                --max-online=$PER_SHARD \
                --seed=$start \
                --scenario=$MODE \
                $session_args \
                $unlock_args \
                $ring_args \
                --environment=sandbox \
                --run-id=$run \
                --serve-after=0 \
                > /tmp/result.json 2> /tmp/error.log
              echo \$? > /tmp/exit-code
              touch /tmp/done
              sleep 900
          env:
            - name: LOAD_TEST_TOKEN_SECRET
              valueFrom:
                secretKeyRef:
                  name: farm-secrets
                  key: load-test-token-secret
          resources:
            requests: {cpu: "2", memory: 4Gi}
            limits: {cpu: "2", memory: 4Gi}
EOF
done

for index in $(seq 0 $((SHARDS - 1))); do
  job=${JOBS[$index]}
  pod=''
  for _ in $(seq 1 300); do
    pod=$("${K[@]}" get pod -l job-name="$job" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
    phase=''; [[ -z "$pod" ]] || phase=$("${K[@]}" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
    [[ "$phase" == Running ]] && break
    [[ "$phase" != Failed ]] || fail "$job failed before release"
    sleep 1
  done
  [[ -n "$pod" && $("${K[@]}" get pod "$pod" -o jsonpath='{.status.phase}') == Running ]] || fail "$job was not scheduled"
  PODS+=("$pod")
done

date -u +%Y-%m-%dT%H:%M:%SZ > "$DIR/test-start-utc.txt"
START_EPOCH=$(date +%s)
(
  printf 'epoch\n'
  while :; do
    printf '%s\n' "$(date +%s)"
    "${K[@]}" top pod --no-headers 2>/dev/null || true
    printf '%s\n' '--'
    sleep 2
  done
) > "$DIR/pod-top-samples.txt" 2> "$DIR/pod-top-samples.stderr" &
SAMPLER_PID=$!

release_pids=()
for pod in "${PODS[@]}"; do
  "${K[@]}" exec "$pod" -c live-farm-bot -- touch /tmp/start &
  release_pids+=("$!")
done
for pid in "${release_pids[@]}"; do wait "$pid"; done

for index in $(seq 0 $((SHARDS - 1))); do
  pod=${PODS[$index]}
  done_flag=0
  deadline=$((SECONDS + RUN_TIMEOUT_SECONDS))
  while (( SECONDS < deadline )); do
    if "${K[@]}" exec "$pod" -c live-farm-bot -- test -f /tmp/done >/dev/null 2>&1; then done_flag=1; break; fi
    phase=$("${K[@]}" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
    [[ "$phase" != Failed ]] || break
    sleep 2
  done
  [[ "$done_flag" == 1 ]] || { "${K[@]}" logs "$pod" > "$DIR/shard-$index.pod.log" 2>&1 || true; fail "shard $index did not finish"; }
  "${K[@]}" exec "$pod" -c live-farm-bot -- cat /tmp/result.json > "$DIR/shard-$index-result.json"
  "${K[@]}" exec "$pod" -c live-farm-bot -- cat /tmp/error.log > "$DIR/shard-$index.stderr" || true
  "${K[@]}" exec "$pod" -c live-farm-bot -- cat /tmp/exit-code > "$DIR/shard-$index.exit-code" || true
done

date -u +%Y-%m-%dT%H:%M:%SZ > "$DIR/test-end-utc.txt"
END_EPOCH=$(date +%s)
kill "$SAMPLER_PID" >/dev/null 2>&1 || true
wait "$SAMPLER_PID" >/dev/null 2>&1 || true
SAMPLER_PID=''
"${K[@]}" get pods -o json > "$DIR/pods-after.json"

PROM_POD=$("${K[@]}" get pod -l app=farm-prometheus -o jsonpath='{.items[0].metadata.name}')
query_range() {
  local name=$1 query=$2 encoded
  encoded=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$query")
  "${K[@]}" exec "$PROM_POD" -c prometheus -- wget -qO- \
    "http://127.0.0.1:9090/api/v1/query_range?query=$encoded&start=$START_EPOCH&end=$END_EPOCH&step=2" \
    > "$DIR/$name.json"
}
query_range ws-active 'sum(farmgate_ws_conn_active)'
query_range command-results 'sum(rate(farm_gate_command_results_total[30s]))'
query_range command-failures 'sum(rate(farm_gate_command_results_total{status=~"REJECTED|UNAVAILABLE"}[30s]))'
query_range join-pending 'sum(farm_gate_pending_join_current)'
query_range redis-rtt-p95 'histogram_quantile(0.95,sum by(le)(rate(farm_redis_workload_round_trip_duration_seconds_bucket[30s])))'
query_range redis-error 'max(farm_redis_dependency_error_percent)'
query_range dirty-oldest 'max(farm_actor_dirty_writeback_oldest_age_seconds)'
query_range dirty-depth 'sum(farm_actor_dirty_writeback_queue_depth)'

python3 - "$DIR" "$TOTAL" "$SHARDS" "$START_EPOCH" "$END_EPOCH" <<'PY'
import json,sys
from datetime import datetime
D,total,shards,start,end=sys.argv[1],int(sys.argv[2]),int(sys.argv[3]),int(sys.argv[4]),int(sys.argv[5])
values=[]
for i in range(shards):
    lines=[line.strip() for line in open(f'{D}/shard-{i}-result.json') if line.strip()]
    values.append(json.loads(lines[-1]))
def add(path):
    result=0
    for value in values:
        current=value
        for key in path:
            current=current.get(key,{}) if isinstance(current,dict) else 0
        if isinstance(current,(int,float)): result += current
    return result
def maximum(path):
    result=[]
    for value in values:
        current=value
        for key in path:
            current=current.get(key,{}) if isinstance(current,dict) else 0
        if isinstance(current,(int,float)): result.append(current)
    return max(result,default=0)
def prom_max(name):
    try:
        payload=json.load(open(f'{D}/{name}.json'))
        return max((float(point[1]) for series in payload['data']['result'] for point in series.get('values',[])),default=None)
    except Exception:
        return None
elapsed=max(1,end-start)
def instant(value):
    return datetime.fromisoformat(value.replace('Z','+00:00')).timestamp()
driver_start=min((instant(value['started_at']) for value in values),default=float(start))
driver_end=max((instant(value['finished_at']) for value in values),default=float(end))
driver_elapsed=max(0.001,driver_end-driver_start)
summary={
    'total_bots':total,'driver_shards':shards,'wall_seconds':elapsed,
    'driver_elapsed_seconds':driver_elapsed,
    'attempted':add(['summary','attempted']),'ready':add(['summary','ready']),
    'succeeded':add(['summary','succeeded']),'failed':add(['summary','failed']),
    'actions':add(['summary','actions']),'rejected':add(['summary','rejected']),
    'processing':add(['summary','processing']),'pending':add(['summary','pending']),
    'projection_pending':add(['summary','projection_pending']),'timeouts':add(['summary','timeouts']),
    'cold_ready_per_second':add(['summary','ready'])/driver_elapsed,
    'reported_online_peak_sum':add(['throughput','online_peak']),
    'reported_actions_per_second':add(['throughput','actions_per_second']),
    'worst_driver_p95_ms':maximum(['latency','p95_ms']),
    'worst_driver_p99_ms':maximum(['latency','p99_ms']),
    'worst_login_p95_ms':maximum(['phases','login','p95_ms']),
    'worst_hello_p95_ms':maximum(['phases','hello','p95_ms']),
    'worst_join_p95_ms':maximum(['phases','join','p95_ms']),
    'prometheus_ws_active_max':prom_max('ws-active'),
    'prometheus_command_results_per_second_max':prom_max('command-results'),
    'prometheus_command_failures_per_second_max':prom_max('command-failures'),
    'prometheus_join_pending_max':prom_max('join-pending'),
    'prometheus_redis_rtt_p95_seconds_max':prom_max('redis-rtt-p95'),
    'prometheus_redis_error_percent_max':prom_max('redis-error'),
    'prometheus_dirty_oldest_age_seconds_max':prom_max('dirty-oldest'),
    'prometheus_dirty_queue_depth_max':prom_max('dirty-depth'),
}
summary['strict_pass']=(summary['attempted']==total and summary['ready']==total and summary['succeeded']==total and
    summary['failed']==0 and summary['rejected']==0 and summary['timeouts']==0 and summary['pending']==0)
with open(f'{D}/summary.json','w') as out:
    json.dump(summary,out,indent=2,sort_keys=True); out.write('\n')
print(json.dumps(summary,indent=2,sort_keys=True))
PY

for job in "${JOBS[@]}"; do
  "${K[@]}" delete job "$job" --ignore-not-found --wait=false >/dev/null
done
JOBS=()
echo "evidence: $DIR"
