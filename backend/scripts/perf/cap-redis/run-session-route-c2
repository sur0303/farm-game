#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
TASK_DIR="$ROOT/docs/verification/perf/session-route-c2"
MODE=${1:-smoke}

case "$MODE" in
  smoke|full) ;;
  *) echo "usage: $0 [smoke|full]" >&2; exit 2 ;;
esac

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required to start an isolated ephemeral Redis" >&2
  exit 2
fi

build_dir=$(mktemp -d /tmp/session-route-c2-build.XXXXXX)
active_container=""
cleanup() {
  if [[ -n "$active_container" ]]; then
    docker rm -f "$active_container" >/dev/null 2>&1 || true
  fi
  rm -rf "$build_dir"
}
trap cleanup EXIT INT TERM

GOFLAGS=-buildvcs=false go build -trimpath -o "$build_dir/session-route-c2" "$ROOT/cmd/cap-redis/session-route-c2"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
train_id="session-route-c2-${stamp}-$$"
train_dir="$TASK_DIR/results/$train_id"
mkdir -p "$train_dir"

active_container="session-route-c2-${stamp,,}-$$"
secret=$(openssl rand -hex 24)
docker run -d --name "$active_container" \
  --cpus 2 --memory 2g --memory-swap 2g \
  -p 127.0.0.1::6379 \
  redis:7.4-alpine \
  redis-server --save '' --appendonly no --protected-mode yes \
    --requirepass "$secret" --maxmemory 1gb --maxmemory-policy noeviction >/dev/null

port=$(docker port "$active_container" 6379/tcp | awk -F: '{print $NF}')
for _ in $(seq 1 100); do
  if docker exec -e REDISCLI_AUTH="$secret" "$active_container" redis-cli ping 2>/dev/null | grep -qx PONG; then
    break
  fi
  sleep 0.1
done
docker exec -e REDISCLI_AUTH="$secret" "$active_container" redis-cli ping 2>/dev/null | grep -qx PONG

iterations=1
if [[ "$MODE" == full ]]; then
  iterations=${SESSION_ROUTE_C2_ITERATIONS:-5}
fi

output="$train_dir/evidence.json"
export SESSION_ROUTE_C2_REDIS_URL="redis://:${secret}@127.0.0.1:${port}/0"
set +e
"$build_dir/session-route-c2" \
  --redis-url "$SESSION_ROUTE_C2_REDIS_URL" \
  --output "$output" \
  --run-id "$train_id" \
  --mode "$MODE" \
  --iterations "$iterations" | tee "$train_dir/stdout.txt"
status=${PIPESTATUS[0]}
set -e
unset SESSION_ROUTE_C2_REDIS_URL

docker inspect "$active_container" --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.Image}}' \
  > "$train_dir/container-limits.txt"
docker rm -f "$active_container" >/dev/null
active_container=""
unset secret

printf 'SESSION_ROUTE_C2_TRAIN=%s MODE=%s EVIDENCE=%s STATUS=%s\n' "$train_id" "$MODE" "$output" "$status"
exit "$status"
