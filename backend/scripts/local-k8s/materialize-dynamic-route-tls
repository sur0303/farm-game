#!/usr/bin/env bash
set -euo pipefail

LAB_ROOT="${FARM_L2_LAB_ROOT:-/data/farm-l2-r2}"
KUBECONFIG="${KUBECONFIG:-$LAB_ROOT/runtime/kubeconfig}"
RUN_ID="${ROUTE_RUN_ID:-}"
MODE="${1:---dry-run}"
NAMESPACE="farm-route-dynamic"
KUBE_CONTEXT="farm-l2-r2"
KUBECTL_BIN=$(command -v kubectl)
kubectl() { timeout --foreground 240s "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG" --context "$KUBE_CONTEXT" "$@"; }
SECRET="farm-route-dynamic-tls"

case "$MODE" in --dry-run|--apply) ;; *) echo "usage: ROUTE_RUN_ID=<id> $0 [--dry-run|--apply]" >&2; exit 2;; esac
[[ "$RUN_ID" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo "materialize-dynamic-route-tls: ROUTE_RUN_ID is required" >&2; exit 1; }
TLS_DIR="$LAB_ROOT/runtime/tls/dynamic-route/$RUN_ID"
RECEIPT="$LAB_ROOT/receipts/dynamic-route-tls-$RUN_ID.json"

if [[ "$MODE" == "--dry-run" ]]; then
  printf '%s\n' '{"schema_version":"farm-dynamic-route-tls-plan.v1","status":"DRY_RUN_NOT_MATERIALIZED","namespace":"farm-route-dynamic","secret":"farm-route-dynamic-tls","exact_single_san_identities":true,"company_redis_contacted":false}'
  exit 0
fi

[[ -s "$KUBECONFIG" ]] || { echo "materialize-dynamic-route-tls: kubeconfig missing" >&2; exit 1; }
[[ "$(kubectl config current-context)" == "farm-l2-r2" ]] || { echo "materialize-dynamic-route-tls: refusing non-lab context" >&2; exit 1; }
kubectl config view --minify -o json | python3 -c 'import json,sys; d=json.load(sys.stdin); ok=d.get("current-context")=="farm-l2-r2" and d.get("contexts",[{}])[0].get("context",{}).get("cluster")=="default" and d.get("clusters",[{}])[0].get("cluster",{}).get("server")=="https://127.0.0.1:6443"; sys.exit(0 if ok else "lab cluster identity mismatch")'
KUBECONFIG="$KUBECONFIG" kubectl get namespace "$NAMESPACE" >/dev/null
[[ ! -e "$RECEIPT" ]] || { echo "materialize-dynamic-route-tls: immutable receipt exists" >&2; exit 1; }
install -d -m 0700 "$TLS_DIR"

openssl req -x509 -newkey rsa:3072 -nodes -sha256 -days 14 \
  -subj "/CN=farm-dynamic-route-local-ca" \
  -keyout "$TLS_DIR/ca.key" -out "$TLS_DIR/ca.crt" >/dev/null 2>&1

generate_leaf() {
  local name="$1" identity="$2"
  local key="$TLS_DIR/$name.key" cert="$TLS_DIR/$name.crt" csr="$TLS_DIR/$name.csr" config="$TLS_DIR/$name.cnf"
  cat >"$config" <<EOF
[req]
distinguished_name = dn
prompt = no
req_extensions = req_ext
[dn]
O = farm-dynamic-route-local
[req_ext]
subjectAltName = DNS:$identity
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
[leaf_ext]
subjectAltName = DNS:$identity
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth,clientAuth
EOF
  openssl req -new -newkey rsa:3072 -nodes -sha256 -config "$config" -keyout "$key" -out "$csr" >/dev/null 2>&1
  openssl x509 -req -days 14 -sha256 -in "$csr" -CA "$TLS_DIR/ca.crt" -CAkey "$TLS_DIR/ca.key" -CAcreateserial \
    -extfile "$config" -extensions leaf_ext -out "$cert" >/dev/null 2>&1
  [[ "$(openssl x509 -in "$cert" -noout -ext subjectAltName | tail -n 1 | xargs)" == "DNS:$identity" ]]
  ! openssl x509 -in "$cert" -noout -subject -nameopt RFC2253 | grep -Eq '(^|[,=])CN='
  [[ "$(openssl x509 -in "$cert" -pubkey -noout | sha256sum | awk '{print $1}')" == "$(openssl pkey -in "$key" -pubout | sha256sum | awk '{print $1}')" ]]
}

generate_leaf route-controller "route-controller.$NAMESPACE.svc.cluster.local"
generate_leaf route-client "route-client.$NAMESPACE.local"
generate_leaf route-operator "route-operator.$NAMESPACE.local"
generate_leaf gate-verifier "farm-gate-verifier.$NAMESPACE.svc.cluster.local"
generate_leaf holder-server "holder-control.$NAMESPACE.svc.cluster.local"
chmod 0600 "$TLS_DIR"/*

KUBECONFIG="$KUBECONFIG" kubectl -n "$NAMESPACE" create secret generic "$SECRET" \
  --from-file=ca.crt="$TLS_DIR/ca.crt" \
  --from-file=route-controller.crt="$TLS_DIR/route-controller.crt" \
  --from-file=route-controller.key="$TLS_DIR/route-controller.key" \
  --from-file=route-client.crt="$TLS_DIR/route-client.crt" \
  --from-file=route-client.key="$TLS_DIR/route-client.key" \
  --from-file=route-operator.crt="$TLS_DIR/route-operator.crt" \
  --from-file=route-operator.key="$TLS_DIR/route-operator.key" \
  --from-file=gate-verifier.crt="$TLS_DIR/gate-verifier.crt" \
  --from-file=gate-verifier.key="$TLS_DIR/gate-verifier.key" \
  --from-file=holder-server.crt="$TLS_DIR/holder-server.crt" \
  --from-file=holder-server.key="$TLS_DIR/holder-server.key" \
  --dry-run=client -o yaml | KUBECONFIG="$KUBECONFIG" kubectl apply -f - >/dev/null
tls_secret_uid=$(KUBECONFIG="$KUBECONFIG" kubectl -n "$NAMESPACE" get secret "$SECRET" -o jsonpath='{.metadata.uid}')
tls_secret_uid_sha=$(printf '%s' "$tls_secret_uid" | sha256sum | awk '{print $1}')

python3 - "$RECEIPT" "$RUN_ID" "$TLS_DIR" "$tls_secret_uid_sha" <<'PY'
import hashlib,json,os,sys,tempfile
path,run_id,root,tls_secret_uid_sha=sys.argv[1:]
identities={
 "route-controller":"route-controller.farm-route-dynamic.svc.cluster.local",
 "route-client":"route-client.farm-route-dynamic.local",
 "route-operator":"route-operator.farm-route-dynamic.local",
 "gate-verifier":"farm-gate-verifier.farm-route-dynamic.svc.cluster.local",
 "holder-server":"holder-control.farm-route-dynamic.svc.cluster.local",
}
def sha(name): return hashlib.sha256(open(os.path.join(root,name),'rb').read()).hexdigest()
value={
 "schema_version":"farm-dynamic-route-tls-receipt.v1","status":"MATERIALIZED_LOCAL_ONLY",
 "run_id":run_id,"namespace":"farm-route-dynamic","secret":"farm-route-dynamic-tls",
 "secret_key_names":["ca.crt","gate-verifier.crt","gate-verifier.key","holder-server.crt","holder-server.key","route-client.crt","route-client.key","route-controller.crt","route-controller.key","route-operator.crt","route-operator.key"],
 "identities":identities,"secret_uid_sha256":tls_secret_uid_sha,"ca_certificate_sha256":sha("ca.crt"),
 "leaf_certificate_sha256":{name:sha(name+".crt") for name in identities},
 "private_key_sha256":{name:sha(name+".key") for name in identities},
 "certificate_private_key_public_match":True,
 "leaf_exactly_one_dns_san":True,"leaf_common_name_present":False,
 "private_key_persisted_in_evidence":False,"company_redis_contacted":False,
 "network_policy_enforcement":"NOT_CLAIMED",
}
os.makedirs(os.path.dirname(path),exist_ok=True)
fd,temp=tempfile.mkstemp(prefix=".dynamic-route-tls-",dir=os.path.dirname(path),text=True)
with os.fdopen(fd,"w") as out:
 json.dump(value,out,sort_keys=True,indent=2); out.write("\n"); out.flush(); os.fsync(out.fileno())
os.chmod(temp,0o640); os.link(temp,path); os.unlink(temp)
print(json.dumps(value,sort_keys=True,indent=2))
PY
