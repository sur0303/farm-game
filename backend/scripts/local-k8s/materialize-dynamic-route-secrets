#!/usr/bin/env bash
set -euo pipefail

LAB_ROOT="${FARM_L2_LAB_ROOT:-/data/farm-l2-r2}"
KUBECONFIG="${KUBECONFIG:-$LAB_ROOT/runtime/kubeconfig}"
RUN_ID="${ROUTE_RUN_ID:-}"
MODE="${1:---dry-run}"
NAMESPACE="farm-route-dynamic"
KUBE_CONTEXT="farm-l2-r2"
KUBECTL_BIN=$(command -v kubectl)
kubectl() { timeout --foreground 240s "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG" --context "$KUBE_CONTEXT" "$@"; }
RECEIPT="$LAB_ROOT/receipts/dynamic-route-secrets-$RUN_ID.json"
case "$MODE" in --dry-run|--apply) ;; *) echo "usage: ROUTE_RUN_ID=<id> $0 [--dry-run|--apply]" >&2; exit 2;; esac
[[ "$RUN_ID" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo "materialize-dynamic-route-secrets: ROUTE_RUN_ID is required" >&2; exit 1; }
[[ -s "$KUBECONFIG" ]] || { echo "materialize-dynamic-route-secrets: kubeconfig missing" >&2; exit 1; }
[[ "$(kubectl config current-context)" == "farm-l2-r2" ]] || { echo "materialize-dynamic-route-secrets: refusing non-lab context" >&2; exit 1; }
kubectl config view --minify -o json | python3 -c 'import json,sys; d=json.load(sys.stdin); ok=d.get("current-context")=="farm-l2-r2" and d.get("contexts",[{}])[0].get("context",{}).get("cluster")=="default" and d.get("clusters",[{}])[0].get("cluster",{}).get("server")=="https://127.0.0.1:6443"; sys.exit(0 if ok else "lab cluster identity mismatch")'
if [[ "$MODE" == "--dry-run" ]]; then
  printf '%s\n' '{"schema_version":"farm-dynamic-route-secret-plan.v1","status":"DRY_RUN_NOT_MATERIALIZED","namespace":"farm-route-dynamic","company_redis_contacted":false}'
  exit 0
fi
[[ ! -e "$RECEIPT" ]] || { echo "materialize-dynamic-route-secrets: immutable receipt exists" >&2; exit 1; }
KUBECONFIG="$KUBECONFIG" kubectl get namespace "$NAMESPACE" >/dev/null
python3 - <<'PY' | KUBECONFIG="$KUBECONFIG" kubectl apply -f - >/dev/null
import base64,json,secrets
b64=lambda n:base64.urlsafe_b64encode(secrets.token_bytes(n)).rstrip(b"=").decode()
print(json.dumps({
 "apiVersion":"v1","kind":"Secret","metadata":{"name":"farm-dynamic-secrets","namespace":"farm-route-dynamic","labels":{"farm.io/secret-scope":"dynamic-local-only"}},"type":"Opaque",
 "stringData":{
  "redis-url":"redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0",
  "authority-redis-url":"redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0",
  "runtime-redis-url":"redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0",
  "projection-redis-url":"redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0",
  "permit-secret":b64(48),"http-session-cookie-keyring":"2="+b64(48)+",1="+b64(48),
  "web-login-rate-limit-secret":b64(48),"theft-prf-hmac-secret":b64(48),"load-test-token-secret":b64(48),
 }
}))
PY
uid=$(KUBECONFIG="$KUBECONFIG" kubectl -n "$NAMESPACE" get secret farm-dynamic-secrets -o jsonpath='{.metadata.uid}')
uid_sha=$(printf '%s' "$uid" | sha256sum | awk '{print $1}')
value_hashes=$(KUBECONFIG="$KUBECONFIG" kubectl -n "$NAMESPACE" get secret farm-dynamic-secrets -o json | python3 -c 'import base64,hashlib,json,sys; d=json.load(sys.stdin)["data"]; print(json.dumps({k:hashlib.sha256(base64.b64decode(v)).hexdigest() for k,v in sorted(d.items())},sort_keys=True,separators=(",",":")))')
python3 - "$RECEIPT" "$RUN_ID" "$uid_sha" "$value_hashes" <<'PY'
import hashlib,json,os,sys,tempfile
path,run_id,uid_sha,value_hashes=sys.argv[1:]
hashes=json.loads(value_hashes)
redis_keys={"redis-url","authority-redis-url","runtime-redis-url","projection-redis-url"}
expected=redis_keys|{"permit-secret","http-session-cookie-keyring","web-login-rate-limit-secret","theft-prf-hmac-secret","load-test-token-secret"}
if set(hashes)!=expected:
 raise SystemExit("materialize-dynamic-route-secrets: Secret key set mismatch")
expected_redis_url_sha256=hashlib.sha256(b'redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0').hexdigest()
if any(hashes.get(key)!=expected_redis_url_sha256 for key in redis_keys):
 raise SystemExit("materialize-dynamic-route-secrets: local Redis domain URL mismatch")
value={"schema_version":"farm-dynamic-route-secret-receipt.v1","status":"MATERIALIZED_LOCAL_ONLY","run_id":run_id,"namespace":"farm-route-dynamic","secret":"farm-dynamic-secrets","secret_uid_sha256":uid_sha,"key_value_sha256":hashes,"expected_local_redis_url_sha256":expected_redis_url_sha256,"redis_domain_secret_keys":sorted(redis_keys-{"redis-url"}),"required_key_count":9,"raw_values_persisted":False,"redis_profile":"LOCAL_REDIS_CLUSTER_3M3S_THREE_CLIENT_POOLS_NOT_FAILURE_ISOLATED","redis_failure_domains_claimed":False,"company_redis_contacted":False}
os.makedirs(os.path.dirname(path),exist_ok=True)
fd,temp=tempfile.mkstemp(prefix=".dynamic-route-secrets-",dir=os.path.dirname(path),text=True)
with os.fdopen(fd,"w") as out:
 json.dump(value,out,sort_keys=True,indent=2); out.write("\n"); out.flush(); os.fsync(out.fileno())
os.chmod(temp,0o640); os.link(temp,path); os.unlink(temp)
print(json.dumps(value,sort_keys=True,indent=2))
PY
