#!/usr/bin/env bash
set -euo pipefail

LAB_ROOT="${FARM_L2_LAB_ROOT:-/data/farm-l2-r2}"
KUBECONFIG="${KUBECONFIG:-$LAB_ROOT/runtime/kubeconfig}"
RECEIPT="$LAB_ROOT/receipts/functional-secrets.json"
MODE="${1:---dry-run}"
case "$MODE" in --dry-run|--apply) ;; *) echo "usage: $0 [--dry-run|--apply]" >&2; exit 2;; esac
fail() { echo "materialize-functional-secrets: $*" >&2; exit 1; }
[[ -s "$KUBECONFIG" ]] || fail "kubeconfig missing"
[[ "$(KUBECONFIG="$KUBECONFIG" kubectl config current-context)" == "farm-l2-r2" ]] || fail "refusing non-lab context"

if [[ "$MODE" == "--dry-run" ]]; then
  printf '%s\n' '{"schema_version":"farm-local-functional-secret-plan.v1","status":"DRY_RUN_NOT_MATERIALIZED","namespace":"farm-l2-r2","secret_name":"farm-staging-secrets","redis_profile":"LOCAL_DEDICATED_REDIS","company_redis_contacted":false}'
  exit 0
fi

KUBECONFIG="$KUBECONFIG" kubectl get namespace farm-l2-r2 >/dev/null 2>&1 || fail "farm-l2-r2 namespace missing"
python3 - <<'PY' | KUBECONFIG="$KUBECONFIG" kubectl apply -f - >/dev/null
import base64, json, secrets
b64=lambda n: base64.urlsafe_b64encode(secrets.token_bytes(n)).rstrip(b"=").decode()
value={
  "apiVersion":"v1",
  "kind":"Secret",
  "metadata":{"name":"farm-staging-secrets","namespace":"farm-l2-r2","labels":{"farm.io/secret-scope":"local-functional-runtime-only"}},
  "type":"Opaque",
  "stringData":{
    "redis-url":"redis://farm-local-redis.farm-l2-r2-deps.svc.cluster.local:6379/0",
    "permit-secret":b64(48),
    "http-session-cookie-keyring":"2="+b64(48)+",1="+b64(48),
    "web-login-rate-limit-secret":b64(48),
    "theft-prf-hmac-secret":b64(48),
    "load-test-token-secret":b64(48),
  },
}
print(json.dumps(value))
PY

secret_uid=$(KUBECONFIG="$KUBECONFIG" kubectl -n farm-l2-r2 get secret farm-staging-secrets -o jsonpath='{.metadata.uid}')
secret_uid_sha=$(printf '%s' "$secret_uid" | sha256sum | awk '{print $1}')
python3 - "$RECEIPT" "$secret_uid_sha" <<'PY'
import json,os,sys,tempfile
path,uid_sha=sys.argv[1:]
value={"schema_version":"farm-local-functional-secret-receipt.v1","status":"MATERIALIZED_FUNCTIONAL_ONLY","namespace":"farm-l2-r2","secret_name_sha256":"86b9756c0cf677a9ea6323d1015f32da5a318864ab8d94316a3270fa250665b9","secret_uid_sha256":uid_sha,"required_key_count":6,"redis_profile":"LOCAL_DEDICATED_REDIS","raw_values_persisted":False,"company_redis_contacted":False,"formal_l2_authorized":False}
os.makedirs(os.path.dirname(path),exist_ok=True)
fd,tmp=tempfile.mkstemp(prefix=".secret-receipt-",dir=os.path.dirname(path),text=True)
with os.fdopen(fd,"w") as out: json.dump(value,out,sort_keys=True,indent=2); out.write("\n")
os.replace(tmp,path)
PY
chmod 0640 "$RECEIPT"
cat "$RECEIPT"
