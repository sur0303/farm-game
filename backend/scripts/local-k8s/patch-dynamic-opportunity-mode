    try:
        raise SystemExit(main())
    except (
        json.JSONDecodeError,
        KeyError,
        OSError,
        subprocess.SubprocessError,
        TimeoutError,
        ValueError,
    ) as error:
        print(f"patch-dynamic-opportunity-mode: {error}", file=sys.stderr)
        raise SystemExit(1)
