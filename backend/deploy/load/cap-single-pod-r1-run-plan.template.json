{
  "schema_version": "cap-single-pod-l2.run-plan.v0.1",
  "run_id": "${RUN_ID}",
  "service": "${SERVICE}",
  "profile": "${PROFILE}",
  "phase": "${PHASE}",
  "tier": "${TIER}",
  "duration_seconds": "${DURATION_SECONDS}",
  "ramp_seconds": "${RAMP_SECONDS}",
  "targets": "${TARGETS}",
  "maximum_launch_lag_ms": 50,
  "maximum_inflight": "${MAXIMUM_INFLIGHT}",
  "driver_url": "${DRIVER_URL}",
  "driver_health_url": "${DRIVER_HEALTH_URL}",
  "snapshot_url": "${SNAPSHOT_URL}",
  "collector_health_url": "${COLLECTOR_HEALTH_URL}",
  "oracle_url": "${ORACLE_URL}",
  "oracle_health_url": "${ORACLE_HEALTH_URL}",
  "collector_config_sha256": "${COLLECTOR_CONFIG_SHA256}",
  "oracle_config_sha256": "${ORACLE_CONFIG_SHA256}",
  "driver_binary_sha256": "${DRIVER_BINARY_SHA256}",
  "manifest_path": "${MANIFEST_PATH}",
  "manifest_schema_path": "${MANIFEST_SCHEMA_PATH}",
  "binding_path": "${BINDING_PATH}",
  "contract_path": "${CONTRACT_PATH}",
  "required_metrics_path": "${REQUIRED_METRICS_PATH}",
  "stop_conditions_path": "${STOP_CONDITIONS_PATH}",
  "verdict_rules_path": "${VERDICT_RULES_PATH}",
