{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "farmgame.cap-l2-driver-config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "listen", "service", "profile", "maximum_inflight", "adapter"],
  "properties": {
    "schema_version": {"const": "cap-l2-driver-config.v1"},
    "listen": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{2,5}$"},
    "service": {"enum": ["gate", "player", "farm", "worker"]},
    "profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "maximum_inflight": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "adapter": {"enum": ["design_blocker", "gate_session_v1"]},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_url", "ws_url", "load_secret_env", "player_base"],
      "properties": {
        "http_url": {"type": "string", "pattern": "^https?://(127\\.0\\.0\\.1|\\[::1\\]|localhost)(:[0-9]{2,5})?$"},
        "ws_url": {"type": "string", "pattern": "^wss?://(127\\.0\\.0\\.1|\\[::1\\]|localhost)(:[0-9]{2,5})?/.*$"},
        "tls_ca": {"type": "string", "minLength": 1},
        "load_secret_env": {"type": "string", "minLength": 1, "maxLength": 128},
        "player_base": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"adapter": {"const": "design_blocker"}}, "required": ["adapter"]},
      "then": {"not": {"required": ["gate"]}}
    },
    {
      "if": {"properties": {"adapter": {"const": "gate_session_v1"}}, "required": ["adapter"]},
      "then": {
        "required": ["gate"],
        "properties": {"service": {"const": "gate"}}
      }
    }
  ]
}
