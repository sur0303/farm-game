# farm-game TcaplusDB 配置模板。
# 复制为 tcaplus.conf.local 后填写真实值；*.local 已被 .gitignore 排除。

cluster_name:   <cluster-name>
dir_addr:       <directory-host>
port:           9999
app_id:         <app-id>
password:       <tcaplus-password>
restful_addr:   <restful-address>

# 实际接入还需按 SDK 和平台配置补齐 set_id、zone_id、signature、
# wsa_user、wsa_passwd 等字段。

# Tcaplus 探针进程环境映射（不要把真实 signature 提交到仓库）：
# TCAPLUS_DIR=host:9999
# TCAPLUS_SIGNATURE=<password>
# TCAPLUS_APP=221
# TCAPLUS_ZONE=1
# Tcaplus PB table name is the descriptor message name from ownercore.proto.
# Keep this as OwnerCoreRecord unless the uploaded production schema uses a
# deliberately different generated message/table name.
# TCAPLUS_OWNER_TABLE=OwnerCoreRecord
