# farm-game Redis 配置模板。
# 复制为 redis.conf.local 后填写真实值；*.local 已被 .gitignore 排除。

host:      <redis-host>
port:      6379
password:  <redis-password>
db:        0

# For a Redis Cluster (for example, 3 primaries + 3 replicas), provide at
# least three reachable primary/seed URLs. The application discovers the
# remaining topology from the cluster; database selection must remain 0.
# Values are full redis:// URLs and may contain URL-encoded credentials.
# cluster_urls: redis://:<password>@redis-1:6379/0,redis://:<password>@redis-2:6379/0,redis://:<password>@redis-3:6379/0

# URL 示例：
# redis://:<redis-password>@<redis-host>:6379/0
