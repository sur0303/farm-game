{
  "apiVersion": "v1",
  "kind": "Secret",
  "metadata": {
    "name": "farm-staging-tls",
    "annotations": {
      "farm.io/secret-template": "external-tls-secret-manager-required",
      "farm.io/do-not-commit-values": "true"
    },
    "labels": {
      "app.kubernetes.io/part-of": "farm-game"
    }
  },
  "type": "kubernetes.io/tls",
  "stringData": {
    "tls.crt": "REPLACE_FROM_TLS_SECRET_MANAGER",
    "tls.key": "REPLACE_FROM_TLS_SECRET_MANAGER"
  }
}
