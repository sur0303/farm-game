VITE_FARM_ENV=web
VITE_FARM_PROFILE=showcase
VITE_FARM_PROTOCOL=canonical-final
VITE_API_BASE=/api
VITE_WS_URL=/ws

# For local integration, create an ignored `.env.web.local` or `.env.staging.local`:
# VITE_API_PROXY_TARGET=http://<farm-gate-host>:<port>
# VITE_WS_URL=ws://<farm-gate-host>:<port>/ws
