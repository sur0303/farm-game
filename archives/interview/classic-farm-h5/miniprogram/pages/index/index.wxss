.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #a8d4ea 0%, #87b5d6 30%, #d4a76a 60%, #b8925a 100%);
  padding: 24rpx;
}

/* Header */
.header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; margin-bottom: 16rpx; }
.header-left { display: flex; align-items: baseline; gap: 12rpx; }
.farm-title { font-size: 40rpx; font-weight: 700; color: #3a2f1f; }
.farm-version { font-size: 22rpx; color: #8a7a5a; }
.status-badge { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: 24rpx; font-size: 22rpx; background: rgba(255,255,255,.6); }
.status-badge.authenticated { background: rgba(74,124,89,.15); color: #3d6b4a; }
.status-badge.connecting, .status-badge.authenticating { background: rgba(212,167,106,.15); color: #b1783d; }
.status-badge.disconnected, .status-badge.error { background: rgba(192,57,43,.15); color: #c0392b; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c0392b; }
.status-badge.authenticated .status-dot { background: #27ae60; }

/* Share banner */
.share-banner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx; margin-bottom: 16rpx;
  background: rgba(74,124,89,.1); border-radius: 16rpx;
  color: #3d6b4a; font-size: 26rpx;
}
.back-btn { background: rgba(255,255,255,.6); color: #3d6b4a; font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 12rpx; }

/* Inventory */
.inventory-bar {
  display: flex; justify-content: space-around; padding: 20rpx;
  background: rgba(255,248,230,.85); border-radius: 20rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(58,47,31,.08);
}
.stat { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; color: #3a2f1f; }
.stat-icon { font-size: 32rpx; }
.stat-value { font-weight: 600; }

/* Farm Grid */
.farm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.plot {
  aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  border-radius: 20rpx; border: 2rpx solid #d4a76a;
  background: linear-gradient(180deg, #c9a86c, #b8925a); color: #3a2f1f; font-size: 24rpx;
  position: relative; transition: all .2s ease;
}
.plot.empty { background: linear-gradient(180deg, #d4b48a, #c9a86c); border-style: dashed; border-color: #b8925a; }
.plot.growing { background: linear-gradient(180deg, #a8d5a0, #8fbc8f); border-color: #6b9e6b; }
.plot.mature { background: linear-gradient(180deg, #f0d68a, #e6c35a); border-color: #e6b93d; border-width: 3rpx; box-shadow: 0 0 0 6rpx rgba(230,185,61,.2); }
.plot.watered { border-color: #5b9bd5; box-shadow: 0 0 0 4rpx rgba(91,155,213,.2); }
.plot.selected { border-color: #4a7c59; box-shadow: 0 0 0 6rpx rgba(74,124,89,.3); }
.plot.can-plant, .plot.can-water, .plot.can-harvest { animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100% { box-shadow: 0 0 0 4rpx rgba(74,124,89,.2); } 50% { box-shadow: 0 0 0 10rpx rgba(74,124,89,.4); } }
.plot-icon { font-size: 56rpx; }
.plot-label { font-size: 22rpx; font-weight: 600; }
.water-mark { position: absolute; top: 8rpx; right: 12rpx; font-size: 28rpx; }

/* Tools */
.tools-bar { margin-bottom: 20rpx; }
.tool-group { display: flex; gap: 16rpx; justify-content: center; }
.tool-btn {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 20rpx 32rpx; border-radius: 20rpx; background: rgba(255,248,230,.85);
  border: 2rpx solid transparent; font-size: 24rpx; color: #5a4a32; transition: all .2s ease;
}
.tool-btn.active { background: #4a7c59; color: white; border-color: #3d6b4a; box-shadow: 0 0 0 4rpx rgba(74,124,89,.3); }
.tool-icon { font-size: 36rpx; }

/* Shop */
.shop-bar { display: flex; gap: 16rpx; justify-content: center; margin-bottom: 20rpx; }
.shop-btn { background: #f0e8d8; color: #5a4a32; font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 16rpx; border: 2rpx solid rgba(212,167,106,.3); }

/* Social / Share */
.social-bar { margin-bottom: 16rpx; }
.share-btn {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  width: 100%; background: #f0e8d8; color: #5a4a32; font-size: 28rpx; padding: 20rpx; border-radius: 16rpx;
  border: 2rpx solid rgba(212,167,106,.3);
}
.share-icon { font-size: 32rpx; }

/* Friends */
.friends-bar { margin-bottom: 20rpx; }
.friends-title { font-size: 26rpx; font-weight: 600; color: #5a4a32; margin-bottom: 12rpx; display: block; }
.friends-scroll { display: flex; gap: 16rpx; white-space: nowrap; }
.friend-item {
  display: inline-flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 16rpx 24rpx; background: rgba(255,248,230,.85); border-radius: 16rpx;
  border: 2rpx solid rgba(212,167,106,.3); font-size: 22rpx; color: #5a4a32;
}
.friend-icon { font-size: 36rpx; }

/* Message */
.message-bar {
  padding: 20rpx 24rpx; border-radius: 16rpx; background: rgba(74,124,89,.1);
  color: #3d6b4a; font-size: 26rpx; text-align: center; border: 1rpx solid rgba(74,124,89,.15);
}
.message-bar.error { background: rgba(192,57,43,.1); color: #c0392b; border-color: rgba(192,57,43,.15); }

/* Modal */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.5);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal-card {
  width: 80%; max-width: 600rpx; background: #fff8e6; border-radius: 24rpx; padding: 48rpx;
  display: flex; flex-direction: column; gap: 24rpx; text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,.2);
}
.modal-title { font-size: 36rpx; font-weight: 700; color: #3a2f1f; }
.modal-body { font-size: 28rpx; color: #5a4a32; line-height: 1.6; }
.modal-actions { display: flex; gap: 16rpx; justify-content: center; }
.modal-btn { padding: 16rpx 32rpx; border-radius: 16rpx; font-size: 28rpx; }
.modal-btn.cancel { background: #e8dcc8; color: #5a4a32; }
.modal-btn.confirm { background: #4a7c59; color: white; }
