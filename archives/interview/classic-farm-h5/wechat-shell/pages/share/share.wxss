.state-card {
  width: 100%;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fffaf1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.hint {
  color: #697267;
  line-height: 1.6;
}

button {
  width: 100%;
  background: #3d704d;
  color: #fff;
}