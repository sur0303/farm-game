VITE_FARM_ENV=staging
VITE_FARM_PROFILE=test
VITE_FARM_PROTOCOL=canonical-final
VITE_API_BASE=/api
# Local dev: put overrides in the ignored .env.staging.local file.
#   VITE_API_PROXY_TARGET=http://host:port   # /api dev-server proxy target
#   VITE_WS_URL=/ws                          # client WS path (same-origin)
#   VITE_WS_URL=ws://host:port/ws            # full address; vite derives the
#                                            # /ws proxy target automatically
#   VITE_WS_PROXY_TARGET=ws://host:port      # explicit /ws proxy target (wins)
# Without an explicit VITE_WS_URL, the client uses the wss_endpoint issued by
# farm-gate and finally falls back to same-origin /ws.
VITE_DEMO_PLATFORM_TOKEN=demo-platform-token
VITE_DEMO_SECONDARY_PLATFORM_TOKEN=demo-platform-token-b
