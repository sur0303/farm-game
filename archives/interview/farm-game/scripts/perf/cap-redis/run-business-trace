#!/usr/bin/env bash
# Run one isolated real-H5 end-to-end amplification trace for the seven frozen
# business commands. Correctness failure stops qualification immediately.
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
H5_ROOT="$(realpath "${CAP_BUSINESS_H5_ROOT:?CAP_BUSINESS_H5_ROOT is required}")"
TRAIN_RUN="${CAP_BUSINESS_TRAIN_RUN:-capredis-l1-r1-20260810T053256Z-3107651}"
BUSINESS_COMMIT="${CAP_BUSINESS_COMMIT:-93a66ce76d509d86e8cac8e1d87563d084eba821}"
EVIDENCE_HEAD="${CAP_BUSINESS_EVIDENCE_HEAD:-5b42a4f587263ab0ce8369330321345e240782c7}"
H5_COMMIT="${CAP_BUSINESS_H5_COMMIT:-525c4d324100b17a891f02797c4880fa9a02f70a}"
TOOL_HEAD="$(git -C "$ROOT_DIR" rev-parse HEAD)"
FRIENDSHIP_MODE="${CAP_BUSINESS_FRIENDSHIP_SERVICE_MODE:-local_gate}"
case "$FRIENDSHIP_MODE" in local_gate|remote_player) ;; *) echo "invalid CAP_BUSINESS_FRIENDSHIP_SERVICE_MODE" >&2;exit 2;;esac
STAMP="${CAP_BUSINESS_TRACE_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
OUT="${CAP_BUSINESS_TRACE_OUT:-$ROOT_DIR/docs/verification/perf/cap-redis/CAP-REDIS-L1-R1/results/$TRAIN_RUN/business-trace/$STAMP}"
TMP="$(mktemp -d "/tmp/cap-business-trace-${STAMP}.XXXXXX")"
BIN="$TMP/bin"
mkdir -p "$OUT" "$BIN"
cd "$ROOT_DIR"

container="cap-business-trace-${STAMP,,}"
proxy_pid=""
OVERLAY=""
redis_destroyed=false
cleanup() {
  set +e
  [[ -n "$proxy_pid" ]] && kill "$proxy_pid" 2>/dev/null
  [[ -n "$proxy_pid" ]] && wait "$proxy_pid" 2>/dev/null
  docker rm -f "$container" >/dev/null 2>&1
  [[ -z "$OVERLAY" ]] || rm -rf "$OVERLAY"
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

pick_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()'
}
wait_http() {
  local url="$1" deadline=$((SECONDS + ${2:-30}))
  until curl -fsS "$url" >/dev/null 2>&1; do
    (( SECONDS >= deadline )) && { echo "TIMEOUT: $url" >&2; return 1; }
    sleep .1
  done
}

for name_value in \
  "BUSINESS_COMMIT:$BUSINESS_COMMIT" "EVIDENCE_HEAD:$EVIDENCE_HEAD" \
  "H5_COMMIT:$H5_COMMIT" "TOOL_HEAD:$TOOL_HEAD"; do
  name="${name_value%%:*}"; value="${name_value#*:}"
  [[ "$value" =~ ^[0-9a-f]{40}$ ]] || { echo "$name is not an exact SHA" >&2; exit 1; }
done
[[ "$(git -C "$ROOT_DIR" rev-parse HEAD)" == "$TOOL_HEAD" ]]
[[ "$(git -C "$H5_ROOT" rev-parse HEAD)" == "$H5_COMMIT" ]] || {
  echo "H5 head mismatch" >&2; exit 1;
}
if [[ -n "$(git -C "$H5_ROOT" status --porcelain | grep -vE '^.. test-results/|^.. dist/|^.. node_modules$' || true)" ]]; then
  echo "H5 checkout has non-evidence changes" >&2; exit 1
fi
if ! git -C "$ROOT_DIR" diff --quiet -- cmd/cap-redis scripts/perf/cap-redis ||
   ! git -C "$ROOT_DIR" diff --cached --quiet -- cmd/cap-redis scripts/perf/cap-redis ||
   [[ -n "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=all -- cmd/cap-redis scripts/perf/cap-redis | grep '^??' || true)" ]]; then
  echo "trace tool source is dirty or untracked" >&2; exit 1
fi

# Build test-only binaries and the exact prebuilt static H5 bundle before Redis
# or any measured command window starts.
GOFLAGS=-buildvcs=false go build -trimpath -o "$BIN/resp-trace-proxy" ./cmd/cap-redis/resp-trace-proxy
GOFLAGS=-buildvcs=false go build -trimpath -o "$BIN/business-trace-web" ./cmd/cap-redis/business-trace-web
python3 - "$OUT/tool-artifacts.json" "$TOOL_HEAD" "$BIN/resp-trace-proxy" "$BIN/business-trace-web" \
  "$ROOT_DIR/scripts/perf/cap-redis/business-trace.spec.ts" "$ROOT_DIR/scripts/perf/cap-redis/run-business-trace" <<'PY'
import hashlib,json,pathlib,subprocess,sys
out=pathlib.Path(sys.argv[1]); head=sys.argv[2]; paths=[pathlib.Path(value) for value in sys.argv[3:]]
artifacts={path.name:{'bytes':path.stat().st_size,'sha256':hashlib.sha256(path.read_bytes()).hexdigest()} for path in paths}
out.write_text(json.dumps({'schema_version':'cap-redis-business-trace-tool-artifacts-v1','tool_head':head,
 'go_version':subprocess.check_output(['go','version'],text=True).strip(),'artifacts':artifacts},indent=2,sort_keys=True)+'\n')
PY
H5_DIST="$TMP/h5-dist"
(
  cd "$H5_ROOT"
  ./node_modules/.bin/tsc --noEmit
  FARM_APP_PROFILE=test VITE_FARM_ENV=web VITE_FARM_PROTOCOL=canonical-final VITE_WS_URL=/ws \
    ./node_modules/.bin/vite build --mode web --outDir "$H5_DIST" --emptyOutDir
)
python3 - "$H5_DIST" "$OUT/h5-bundle.json" <<'PY'
import hashlib,json,pathlib,sys
root=pathlib.Path(sys.argv[1]); out=pathlib.Path(sys.argv[2])
rows=[]
for path in sorted(p for p in root.rglob('*') if p.is_file()):
    rows.append({'path':path.relative_to(root).as_posix(),'bytes':path.stat().st_size,'sha256':hashlib.sha256(path.read_bytes()).hexdigest()})
assert rows and any(row['path']=='index.html' for row in rows)
aggregate=hashlib.sha256(json.dumps(rows,sort_keys=True,separators=(',',':')).encode()).hexdigest()
out.write_text(json.dumps({'mode':'PREBUILT_STATIC_BUNDLE','files':rows,'aggregate_sha256':aggregate},indent=2)+'\n')
PY

secret="$(openssl rand -hex 24)"
docker run -d --name "$container" --cpus 2 --memory 1g -p 127.0.0.1::6379 \
  redis:7.4-alpine redis-server --save '' --appendonly no --protected-mode yes --requirepass "$secret" >/dev/null
redis_port="$(docker port "$container" 6379/tcp | awk -F: '{print $NF}')"
for _ in $(seq 1 100); do
  docker exec -e REDISCLI_AUTH="$secret" "$container" redis-cli ping 2>/dev/null | grep -qx PONG && break
  sleep .1
done

proxy_port="$(pick_port)"; control_port="$(pick_port)"; h5_port="$(pick_port)"
TRACE_JSON="$OUT/business-command-amplification.json"
"$BIN/resp-trace-proxy" \
  --listen "127.0.0.1:$proxy_port" --control-listen "127.0.0.1:$control_port" \
  --upstream "127.0.0.1:$redis_port" --output "$TRACE_JSON" \
  --train-run "$TRAIN_RUN" --business-commit "$BUSINESS_COMMIT" --evidence-head "$EVIDENCE_HEAD" \
  --h5-commit "$H5_COMMIT" --tool-head "$TOOL_HEAD" >"$OUT/resp-trace-proxy.log" 2>&1 &
proxy_pid=$!
wait_http "http://127.0.0.1:$control_port/healthz" 30

REDIS_CONFIG="$TMP/redis.conf.local"
cat >"$REDIS_CONFIG" <<EOF
host:      127.0.0.1
port:      $proxy_port
password:  $secret
db:        0
EOF

# Keep the generated Playwright files under ignored H5 test-results. The spec
# itself is frozen in this Backend Head and copied byte-for-byte.
OVERLAY="$H5_ROOT/test-results/cap-business-trace-$STAMP"
mkdir -p "$OVERLAY/src/test/e2e"
ln -s "$H5_ROOT/src/protocol" "$OVERLAY/src/protocol"
cp "$ROOT_DIR/scripts/perf/cap-redis/business-trace.spec.ts" "$OVERLAY/src/test/e2e/business-trace.spec.ts"
CONFIG="$OVERLAY/playwright.config.ts"
python3 - "$CONFIG" "$BIN/business-trace-web" "$H5_DIST" "$h5_port" <<'PY'
import json,pathlib,sys
out=pathlib.Path(sys.argv[1]); web=sys.argv[2]; dist=sys.argv[3]; port=int(sys.argv[4])
command=' '.join([json.dumps(web), '--listen', f'127.0.0.1:{port}', '--dist', json.dumps(dist), '--api', '${FARM_E2E_API_BASE_URL}', '--ws', '${FARM_E2E_WS_PROXY_TARGET}'])
out.write_text(f"""import {{ defineConfig }} from '@playwright/test';
export default defineConfig({{
  testDir: './src/test/e2e', testMatch: ['business-trace.spec.ts'], outputDir: './artifacts',
  workers: 1, retries: 0, timeout: 240_000, reporter: [['line']],
  use: {{ baseURL: 'http://127.0.0.1:{port}', headless: true, viewport: {{ width: 1280, height: 720 }}, trace: 'on', screenshot: 'only-on-failure' }},
  webServer: {{ command: {json.dumps(command)}, url: 'http://127.0.0.1:{port}', reuseExistingServer: false, timeout: 30_000 }},
}});
""")
PY

STACK_OUT="$OUT/stack"
STACK_RUN_ID="cbt$(date -u +%H%M%S)$$"
set +e
CAP_BUSINESS_TRACE_CONTROL_URL="http://127.0.0.1:$control_port" \
FARM_E2E_H5_PORT="$h5_port" \
FARM_REDIS_CONFIG="$REDIS_CONFIG" \
H5_ROOT="$H5_ROOT" \
SMOKE_OUT="$STACK_OUT" \
SMOKE_RUN_ID="$STACK_RUN_ID" \
SMOKE_PLAYWRIGHT_CONFIG="$CONFIG" \
SMOKE_PLAYWRIGHT_TEST="" \
SMOKE_CROP_MATURE_AFTER="5s" \
SMOKE_H5_ALLOWED_ORIGINS="127.0.0.1:$h5_port,localhost:$h5_port" \
SMOKE_REQUIRE_SOCIAL_ORACLE=1 \
SMOKE_FRIENDSHIP_SERVICE_MODE="$FRIENDSHIP_MODE" \
  "$ROOT_DIR/scripts/run-authority-vertical-smoke" 2>&1 | python3 -c '
import re,sys
patterns=(re.compile(r"(redis://:)[^@\s]+(@)"), re.compile(r"((?:PASSWORD|SECRET|TOKEN)=)[^\s]+", re.I))
for line in sys.stdin:
    line=patterns[0].sub(r"\1<redacted>\2", line)
    line=patterns[1].sub(r"\1<redacted>", line)
    sys.stdout.write(line)
' >"$OUT/stack-run.log"
stack_rc=${PIPESTATUS[0]}
set -e
if ((stack_rc != 0)); then
  tail -80 "$OUT/stack-run.log" >&2 || true
  echo "business trace stack failed rc=$stack_rc" >&2
  exit 1
fi

freeze="$(curl -fsS -X POST "http://127.0.0.1:$control_port/freeze")"
python3 -c 'import json,sys; d=json.loads(sys.argv[1]); assert d["verdict"]=="PASS"' "$freeze"
kill "$proxy_pid" 2>/dev/null || true
wait "$proxy_pid" 2>/dev/null || true
proxy_pid=""

# The whole Redis process is unique to this run. Destroy it exactly; no global
# mutation command is used for cleanup.
docker rm -f "$container" >/dev/null
redis_destroyed=true
unset secret

printf 'REDIS_TEARDOWN=DESTROYED_UNIQUE_EPHEMERAL_INSTANCE\nSCRIPT_FLUSH_USED=false\nFLUSHALL_USED=false\n' >"$OUT/cleanup.txt"
python3 - "$OUT" "$TRACE_JSON" "$STACK_OUT" "$TOOL_HEAD" "$FRIENDSHIP_MODE" <<'PY'
import hashlib,json,pathlib,sys
out=pathlib.Path(sys.argv[1]); trace_path=pathlib.Path(sys.argv[2]); stack=pathlib.Path(sys.argv[3]); tool_head=sys.argv[4];friendship_mode=sys.argv[5]
trace=json.loads(trace_path.read_text())
browser=json.loads((stack/'browser-verdict.json').read_text())
protocol=json.loads((stack/'protocol-verdict.json').read_text())
authority=json.loads((stack/'authority-after.json').read_text())
stack_verdict=json.loads((stack/'verdict.json').read_text())
run_manifest=json.loads((stack/'run-manifest.json').read_text())
required={'BUY','SELL','CLAIM_TASK','PLANT','HARVEST','WATER','THEFT'}
rows=trace['rows']
checks={
 'trace_verdict':trace.get('verdict')=='PASS',
 'exact_commands':{row['command'] for row in rows}==required and len(rows)==7,
 'browser_verdict':browser.get('verdict')=='PASS',
 'browser_exact_commands':set(browser.get('tracedCommands',[]))==required,
 'protocol_verdict':protocol.get('verdict')=='PASS',
 'authority_oracle':authority.get('business_oracle',{}).get('verdict')=='PASS',
 'stack_verdict':stack_verdict.get('verdict')=='PASS',
 'tool_head':trace.get('tool_head')==tool_head,
 'friendship_service_mode':run_manifest.get('friendship_service_mode')==friendship_mode,
 'remote_player_rpc':friendship_mode!='remote_player' or run_manifest.get('friendship_service_mode')=='remote_player',
 'all_rows_transport':all(row['redis_ops']>0 and row['total_bytes']==row['request_bytes']+row['response_bytes'] for row in rows),
 'all_rows_commit_receipt':all(row['actor_commit']>0 and row['receipts']==row['actor_commit'] for row in rows),
 'no_redis_errors':all(row['redis_errors']==0 and row['unanswered_requests']==0 for row in rows),
 'no_raw_identity_fields':not any(key in trace_path.read_text() for key in ['ownerA','ownerB','operation_id','redis_url','password']),
}
assert all(checks.values()), checks
source_files=['browser-verdict.json','protocol-verdict.json','authority-after.json','verdict.json']
witness={
 'schema_version':'cap-redis-business-correctness-witness-v1',
 'browser':'PASS','protocol':'PASS','authority_oracle':'PASS','stack':'PASS',
 'friendship_service_mode':friendship_mode,'exact_traced_commands':sorted(required),
 'source_sha256':{name:hashlib.sha256((stack/name).read_bytes()).hexdigest() for name in source_files},
 'identity_policy':'SOURCE_ARTIFACTS_RETAINED_OUTSIDE_PUBLISHED_ALLOWLIST; ONLY HASHES_AND_CLOSED_VERDICTS_PERSISTED',
}
(out/'correctness-witness.json').write_text(json.dumps(witness,indent=2,sort_keys=True)+'\n')
files=['business-command-amplification.json','h5-bundle.json','correctness-witness.json','cleanup.txt','tool-artifacts.json']
qualification={
 'schema_version':'cap-redis-business-trace-qualification-v1','tool_head':tool_head,
 'checks':checks,'verdict':'PASS','redis_teardown':'DESTROYED_UNIQUE_EPHEMERAL_INSTANCE',
 'attachments':{name:hashlib.sha256((out/name).read_bytes()).hexdigest() for name in files},
}
(out/'qualification.json').write_text(json.dumps(qualification,indent=2,sort_keys=True)+'\n')
print(json.dumps({'verdict':'PASS','rows':[{k:r[k] for k in ['command','actor_commit','workflow_writes','orders','due','receipts','redis_ops','total_bytes']} for r in rows]},indent=2))
PY

# Raw stack logs contain source identities needed only to derive the closed,
# hash-bound correctness witness. They are not part of the publishable
# Evidence allowlist and are removed after qualification succeeds.
rm -rf "$OUT/stack" "$OUT/stack-run.log" "$OUT/resp-trace-proxy.log"
echo "CAP_BUSINESS_TRACE=PASS OUT=$OUT"
