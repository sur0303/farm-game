#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import re
import subprocess
from pathlib import Path

SCRIPT = Path(__file__).resolve()
REPO = SCRIPT.parents[2]
OVERLAY = REPO / "deploy/k8s/static-staging/overlays/local-capacity-r2/functional"

issues: list[str] = []
process = subprocess.run(
    ["kubectl", "kustomize", str(OVERLAY)],
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
)
if process.returncode != 0:
    issues.append("kustomize render failed")
render = process.stdout

route_path = OVERLAY / "route-snapshot.render-only.json"
receipt_path = OVERLAY / "route-snapshot.render-only.receipt.json"
try:
    route = json.loads(route_path.read_text())
    receipt = json.loads(receipt_path.read_text())
except Exception:
    route, receipt = {}, {}
    issues.append("route intent or receipt is invalid JSON")

if receipt.get("status") != "PLACEMENT_INTENT_NOT_AUTHORITY_INITIALIZED" or receipt.get("activatable") is not False:
    issues.append("render-only route receipt could be mistaken for activation")
if route.get("player", {}).get("shard_count") != 4 or route.get("farm", {}).get("shard_count") != 4:
    issues.append("checked-in route must remain the 4/4 offline render-only profile")
if any(item.get("lease_expire_at_ms") != 0 for domain in ("player", "farm") for item in route.get(domain, {}).get("routes", [])):
    issues.append("render-only route unexpectedly contains a live lease")
if "namespace: farm-l2-r2" not in render or "name: farm-l2-r2" not in render:
    issues.append("local namespace transform missing")
if "FRIENDSHIP_SERVICE_MODE: remote_player" not in render:
    issues.append("remote_player mode missing")
if "AUTHORITY_MEMBERSHIP_MODE: composed" not in render:
    issues.append("composed membership mode missing")
if render.count("farm.io/activation-status: RENDER_ONLY_NOT_AUTHORITY_INITIALIZED") != 5:
    issues.append("every workload must carry the render-only activation block")
if "127.0.0.1:5001/farm/backend@sha256:" not in render:
    issues.append("local backend registry binding missing")
if not re.search(r"sha256:0{64}", render):
    issues.append("render placeholder digest missing")
if any(token in render.lower() for token in ("redis://", "rediss://", "password=")):
    issues.append("render contains a raw Redis credential or URL")
for holder in route.get("holders", []):
    boot = str(holder.get("boot_id", ""))
    if "-functional-g1-" not in boot or "static-route-v1" in boot:
        issues.append("Holder boot is not generation-aware")

render_sha = hashlib.sha256(render.encode()).hexdigest() if render else None
result = {
    "schema_version": "farm-local-functional-render-verdict.v1",
    "status": "FUNCTIONAL_RENDERED_NOT_ACTIVATABLE" if not issues else "REJECTED",
    "issues": issues,
    "render_sha256": render_sha,
    "route_intent_sha256": receipt.get("route_intent_sha256"),
    "route_status": receipt.get("status"),
    "image_identity_status": "UNBOUND_ZERO_DIGEST",
    "company_redis_contacted": False,
    "cluster_applied": False,
    "formal_l2_authorized": False,
}
print(json.dumps(result, sort_keys=True, indent=2))
raise SystemExit(0 if not issues else 1)
