#!/usr/bin/env python3
from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import socket
import subprocess
import tempfile
import time
from pathlib import Path

NAMESPACE = "farm-route-dynamic"
KUBE_CONTEXT = "farm-l2-r2"
EXPECTED_SERVER = "https://127.0.0.1:6443"
GATE_SERVICE_PORT = 8080
H5_SERVICE_PORT = 80
STAGES = {
    "compatibility": (
        "full",
        "pubsub",
        "DYNAMIC_OPPORTUNITY_COMPATIBILITY_ACTIVATED_NOT_TRAFFIC_VERIFIED",
    ),
    "shadow": (
        "narrow-shadow",
        "shadow-direct",
        "DYNAMIC_OPPORTUNITY_SHADOW_ACTIVATED_NOT_TRAFFIC_VERIFIED",
    ),
    "final": (
        "narrow",
        "direct",
        "DYNAMIC_OPPORTUNITY_FINAL_ACTIVATED_NOT_TRAFFIC_VERIFIED",
    ),
}


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_json(path: Path) -> dict:
    return json.loads(path.read_text())


def write_exclusive(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(value, stream, sort_keys=True, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def evidence_label(value: str) -> str:
    if not value:
        return ""
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", value):
        raise ValueError("evidence label must be lowercase kebab-case")
    return value


def receipt_name(stage: str, label: str, run_id: str) -> str:
    middle = f"{stage}-{label}" if label else stage
    return f"dynamic-h5-product-e2e-{middle}-{run_id}.json"


@contextlib.contextmanager
def formal_lock(lock_path: Path):
    inherited = os.environ.get("DYNAMIC_ROUTE_PARENT_LOCK_FD", "")
    if inherited:
        try:
            descriptor = int(inherited)
            inherited_stat = os.fstat(descriptor)
            path_stat = lock_path.stat()
            if (
                inherited_stat.st_dev != path_stat.st_dev
                or inherited_stat.st_ino != path_stat.st_ino
            ):
                raise ValueError("inherited lock does not match formal lock")
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (OSError, ValueError) as error:
            raise SystemExit(
                "verify-dynamic-h5-product-e2e: invalid inherited formal lock"
            ) from error
        yield
        return
    with lock_path.open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise SystemExit(
                "verify-dynamic-h5-product-e2e: another formal run owns the lock"
            ) from error
        yield


def available_ports(count: int) -> list[int]:
    listeners: list[socket.socket] = []
    try:
        for _ in range(count):
            listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            listener.bind(("127.0.0.1", 0))
            listeners.append(listener)
        return [int(listener.getsockname()[1]) for listener in listeners]
    finally:
        for listener in listeners:
            listener.close()


def vite_proxy_config(
    gate_port: int,
    h5_port: int,
    proxy_port: int,
    certificate_pem: str,
    private_key_pem: str,
) -> str:
    return (
        "export default {server:{host:'127.0.0.1',"
        f"port:{proxy_port},strictPort:true,"
        f"https:{{cert:{json.dumps(certificate_pem)},key:{json.dumps(private_key_pem)}}},"
        "allowedHosts:['farm.dynamic.local'],proxy:{"
        f"'/api':{{target:'http://127.0.0.1:{gate_port}',changeOrigin:true}},"
        f"'/ws':{{target:'ws://127.0.0.1:{gate_port}',changeOrigin:true,ws:true}},"
        f"'/':{{target:'http://127.0.0.1:{h5_port}',changeOrigin:true}}"
        "}}};\n"
    )


def render_playwright_config(h5_root: Path, proxy_port: int) -> str:
    return (
        "export default {"
        f"testDir:{json.dumps(str(h5_root / 'src/test/e2e'))},"
        "testMatch:'web-friend-opportunity-realtime.spec.ts',"
        f"use:{{baseURL:'https://farm.dynamic.local:{proxy_port}',"
        "trace:'retain-on-failure',ignoreHTTPSErrors:true,launchOptions:{args:["
        "'--host-resolver-rules=MAP farm.dynamic.local 127.0.0.1',"
        "'--no-proxy-server']}},workers:1};\n"
    )


def wait_tcp(port: int, process: subprocess.Popen, timeout: float = 30) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError(f"process exited before port {port} became ready")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.5):
                return
        except OSError:
            time.sleep(0.2)
    raise TimeoutError(f"port {port} did not become ready")


def stop(process: subprocess.Popen | None) -> None:
    if process is None or process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)


def git_output(root: Path, *arguments: str) -> str:
    return subprocess.check_output(
        ["git", "-C", str(root), *arguments],
        text=True,
        timeout=30,
    ).strip()


def kubectl_command(kubeconfig: Path) -> list[str]:
    return [
        "kubectl",
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        KUBE_CONTEXT,
        "--request-timeout=30s",
    ]


def verify_cluster(command: list[str]) -> None:
    context = subprocess.check_output(
        [*command, "config", "current-context"],
        text=True,
        timeout=35,
    ).strip()
    view = json.loads(subprocess.check_output(
        [*command, "config", "view", "--minify", "-o", "json"],
        text=True,
        timeout=35,
    ))
    clusters = view.get("clusters", [])
    if (
        context != KUBE_CONTEXT
        or len(clusters) != 1
        or clusters[0].get("cluster", {}).get("server") != EXPECTED_SERVER
    ):
        raise ValueError("lab cluster identity mismatch")


def validated_receipts(
    lab: Path,
    run_id: str,
    stage: str,
    source_head: str,
    h5_root: Path,
) -> tuple[Path, Path, Path, dict]:
    header_mode, hint_mode, activation_status = STAGES[stage]
    apply_path = lab / "receipts" / f"dynamic-route-apply-{run_id}.json"
    activation_path = (
        lab
        / "receipts"
        / f"dynamic-opportunity-mode-{stage}-{run_id}.json"
    )
    h5_image_path = lab / "receipts" / f"dynamic-h5-image-{run_id}.json"
    apply = load_json(apply_path)
    activation = load_json(activation_path)
    h5_image = load_json(h5_image_path)
    handoff = h5_image.get("handoff_validation", {})
    if (
        apply.get("status") != "APPLIED_READY_NOT_G1_VERIFIED"
        or apply.get("run_id") != run_id
        or apply.get("source_head") != source_head
    ):
        raise ValueError("apply/source/run binding mismatch")
    if (
        activation.get("status") != activation_status
        or activation.get("run_id") != run_id
        or activation.get("source_head") != source_head
        or activation.get("stage") != stage
        or activation.get("header_read_mode") != header_mode
        or activation.get("hint_transport") != hint_mode
        or activation.get("traffic_behavior_verified") is not False
    ):
        raise ValueError("opportunity activation receipt mismatch")
    if (
        h5_image.get("status") != "PUBLISHED_LOCAL_DYNAMIC_H5_NOT_DEPLOYED"
        or h5_image.get("run_id") != run_id
        or h5_image.get("build_mode") != "web"
        or handoff.get("environment") != "production"
    ):
        raise ValueError("web/showcase H5 image receipt mismatch")
    if git_output(h5_root, "status", "--porcelain"):
        raise ValueError("H5 source worktree must be clean")
    if (
        git_output(h5_root, "rev-parse", "HEAD") != h5_image.get("source_commit")
        or git_output(h5_root, "rev-parse", "HEAD^{tree}")
        != h5_image.get("source_tree")
    ):
        raise ValueError("H5 source checkout/image identity mismatch")
    return apply_path, activation_path, h5_image_path, h5_image


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--stage", choices=sorted(STAGES), required=True)
    parser.add_argument(
        "--evidence-label",
        default="",
        help="optional immutable rerun label, for example final-g1-post-deadline",
    )
    arguments = parser.parse_args()
    try:
        label = evidence_label(arguments.evidence_label)
    except ValueError as error:
        raise SystemExit(
            f"verify-dynamic-h5-product-e2e: {error}"
        ) from error

    lab = Path(os.environ.get("FARM_L2_LAB_ROOT", "/data/farm-l2-r2"))
    run_id = os.environ.get("ROUTE_RUN_ID", "")
    if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", run_id) is None:
        raise SystemExit("verify-dynamic-h5-product-e2e: ROUTE_RUN_ID required")
    h5_root_raw = os.environ.get("H5_ROOT", "")
    if not h5_root_raw:
        raise SystemExit("verify-dynamic-h5-product-e2e: H5_ROOT required")
    h5_root = Path(h5_root_raw).resolve()
    repository = Path(__file__).resolve().parents[2]
    if git_output(repository, "status", "--porcelain"):
        raise SystemExit(
            "verify-dynamic-h5-product-e2e: source worktree must be clean"
        )
    source_head = git_output(repository, "rev-parse", "HEAD")
    receipt_path = (
        lab
        / "receipts"
        / receipt_name(arguments.stage, label, run_id)
    )
    if receipt_path.exists():
        raise SystemExit(
            "verify-dynamic-h5-product-e2e: immutable receipt exists"
        )
    apply_path, activation_path, h5_image_path, h5_image = validated_receipts(
        lab,
        run_id,
        arguments.stage,
        source_head,
        h5_root,
    )

    kubeconfig = Path(
        os.environ.get("KUBECONFIG", str(lab / "runtime" / "kubeconfig"))
    )
    command = kubectl_command(kubeconfig)
    lock_path = lab / "runtime" / "dynamic-route-formal-run.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    evidence = (
        lab
        / "evidence"
        / "dynamic-h5-product-e2e"
        / run_id
        / arguments.stage
    )
    if label:
        evidence = evidence / label
    if evidence.exists():
        raise SystemExit(
            "verify-dynamic-h5-product-e2e: immutable evidence directory exists"
        )

    with formal_lock(lock_path):
        verify_cluster(command)
        evidence.mkdir(parents=True)
        gate_port, h5_port, proxy_port = available_ports(3)
        gate_log_path = evidence / "gate-port-forward.log"
        h5_log_path = evidence / "h5-port-forward.log"
        proxy_log_path = evidence / "same-origin-proxy.log"
        playwright_log_path = evidence / "playwright.log"
        gate_process: subprocess.Popen | None = None
        h5_process: subprocess.Popen | None = None
        proxy_process: subprocess.Popen | None = None
        error_text: str | None = None
        try:
            with (
                gate_log_path.open("w") as gate_log,
                h5_log_path.open("w") as h5_log,
                proxy_log_path.open("w") as proxy_log,
            ):
                gate_process = subprocess.Popen(
                    [
                        *command,
                        "-n",
                        NAMESPACE,
                        "port-forward",
                        "service/farm-gate",
                        f"{gate_port}:{GATE_SERVICE_PORT}",
                        "--address=127.0.0.1",
                    ],
                    stdout=gate_log,
                    stderr=subprocess.STDOUT,
                    text=True,
                )
                h5_process = subprocess.Popen(
                    [
                        *command,
                        "-n",
                        NAMESPACE,
                        "port-forward",
                        "service/farm-h5",
                        f"{h5_port}:{H5_SERVICE_PORT}",
                        "--address=127.0.0.1",
                    ],
                    stdout=h5_log,
                    stderr=subprocess.STDOUT,
                    text=True,
                )
                wait_tcp(gate_port, gate_process)
                wait_tcp(h5_port, h5_process)
                with tempfile.TemporaryDirectory(
                    prefix=f"farm-h5-e2e-{run_id}-{arguments.stage}-"
                ) as temporary:
                    temporary_path = Path(temporary)
                    private_key_path = temporary_path / "farm-dynamic-local.key"
                    certificate_path = temporary_path / "farm-dynamic-local.crt"
                    subprocess.run(
                        [
                            "openssl",
                            "req",
                            "-x509",
                            "-newkey",
                            "rsa:2048",
                            "-sha256",
                            "-nodes",
                            "-days",
                            "1",
                            "-subj",
                            "/CN=farm.dynamic.local",
                            "-addext",
                            "subjectAltName=DNS:farm.dynamic.local",
                            "-keyout",
                            str(private_key_path),
                            "-out",
                            str(certificate_path),
                        ],
                        check=True,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=30,
                    )
                    proxy_config = temporary_path / "vite-proxy.mjs"
                    proxy_config.write_text(vite_proxy_config(
                        gate_port,
                        h5_port,
                        proxy_port,
                        certificate_path.read_text(),
                        private_key_path.read_text(),
                    ))
                    playwright_config_path = temporary_path / "playwright.mjs"
                    playwright_config_path.write_text(
                        render_playwright_config(h5_root, proxy_port)
                    )
                    proxy_process = subprocess.Popen(
                        [
                            "npx",
                            "vite",
                            "--config",
                            str(proxy_config),
                        ],
                        cwd=h5_root,
                        stdout=proxy_log,
                        stderr=subprocess.STDOUT,
                        text=True,
                    )
                    wait_tcp(proxy_port, proxy_process)
                    environment = os.environ.copy()
                    environment.update({
                        "FARM_E2E_VARIANT": "B2",
                        "FARM_E2E_EVIDENCE_ROOT": str(evidence),
                    })
                    with playwright_log_path.open("w") as playwright_log:
                        result = subprocess.run(
                            [
                                "npx",
                                "playwright",
                                "test",
                                "--config",
                                str(playwright_config_path),
                                "--reporter=line",
                                "--output",
                                str(evidence / "playwright-output"),
                            ],
                            cwd=h5_root,
                            env=environment,
                            stdout=playwright_log,
                            stderr=subprocess.STDOUT,
                            timeout=240,
                        )
                    if result.returncode != 0:
                        raise RuntimeError(
                            f"Playwright product E2E exited {result.returncode}"
                        )
        except Exception as error:
            error_text = f"{type(error).__name__}: {error}"
        finally:
            stop(proxy_process)
            stop(h5_process)
            stop(gate_process)

        result_path = evidence / "result.json"
        product_result = load_json(result_path) if result_path.exists() else {}
        pass_value = (
            error_text is None
            and product_result.get("pass") is True
            and bool(product_result.get("ownerA"))
            and bool(product_result.get("ownerB"))
        )
        evidence_hashes = {
            str(path.relative_to(evidence)): sha256(path)
            for path in sorted(evidence.rglob("*"))
            if path.is_file()
        }
        value = {
            "schema_version": "farm-dynamic-h5-product-e2e-receipt.v1",
            "status": (
                "DYNAMIC_H5_PRODUCT_E2E_VERIFIED"
                if pass_value
                else "DYNAMIC_H5_PRODUCT_E2E_FAILED_EVIDENCE_RETAINED"
            ),
            "run_id": run_id,
            "namespace": NAMESPACE,
            "source_head": source_head,
            "stage": arguments.stage,
            "evidence_label": label or None,
            "header_read_mode": STAGES[arguments.stage][0],
            "hint_transport": STAGES[arguments.stage][1],
            "auth_mode": "showcase_account_register_and_session_login",
            "account_auth_verified": pass_value,
            "packaged_h5_image_loaded": pass_value,
            "same_origin_api_and_websocket_proxy": pass_value,
            "local_test_tls": "ephemeral_self_signed_farm.dynamic.local",
            "h5_source_commit": h5_image.get("source_commit"),
            "h5_source_tree": h5_image.get("source_tree"),
            "h5_build_mode": h5_image.get("build_mode"),
            "h5_image_ref": h5_image.get("registry_ref"),
            "h5_image_receipt_sha256": sha256(h5_image_path),
            "apply_receipt_sha256": sha256(apply_path),
            "activation_receipt_sha256": sha256(activation_path),
            "product_result": product_result,
            "evidence_hashes": evidence_hashes,
            "error": error_text,
            "public_web_tls": "NOT_CLAIMED",
            "company_redis_contacted": False,
            "redis_flush_performed": False,
            "global_scan_performed": False,
            "capacity_qualified": False,
            "eligible_for_mode_traffic_verification": pass_value,
            "eligible_for_product_g1": False,
        }
        write_exclusive(receipt_path, value)
        print(json.dumps(value, sort_keys=True, indent=2))
        return 0 if pass_value else 1


if __name__ == "__main__":
    raise SystemExit(main())
