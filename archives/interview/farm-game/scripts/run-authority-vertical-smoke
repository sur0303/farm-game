#!/usr/bin/env bash
# Authority + Static Assignment Vertical Smoke for A1~A4 premerge.
#
# Exit codes: 0=PASS, 1=FAIL, 2=INCONCLUSIVE
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Render only the diagnostic copy of a command. The returned string is never
# evaluated or passed to a process; the real argv remains the separate "$@"
# below. URI userinfo is redacted while retaining the Redis scheme/host, and
# secret-bearing environment assignments are covered by an allowlist of key
# names rather than by one observed credential.
redact_start_uri() {
  local value="$1" scheme remainder
  case "$value" in
    redis://*|rediss://*)
      scheme="${value%%://*}"
      remainder="${value#*://}"
      if [[ "$remainder" == *@* ]]; then
        # Use the last @ so even malformed/raw userinfo containing an extra @
        # cannot leave a credential fragment in the diagnostic.
        printf '%s://<redacted>@%s' "$scheme" "${remainder##*@}"
        return
      fi
      ;;
  esac
  printf '%s' "$value"
}

redact_start_arg() {
  local arg="$1" key value key_upper
  if [[ "$arg" == *=* ]]; then
    key="${arg%%=*}"
    value="${arg#*=}"
    key_upper="${key^^}"
    case "$key_upper" in
      FARM_REDIS_URL|REDIS_URL|*_REDIS_URL)
        printf '%s=%s' "$key" "$(redact_start_uri "$value")"
        return
        ;;
      *PASSWORD*|*PASSWD*|*TOKEN*|*SECRET*|*CREDENTIAL*|*API_KEY*|*PRIVATE_KEY*)
        printf '%s=<redacted>' "$key"
        return
        ;;
    esac
  elif [[ "$arg" =~ ^(redis|rediss):// ]]; then
    redact_start_uri "$arg"
    return
  fi
  printf '%s' "$arg"
}

render_start_command() {
  local arg redacted shell_arg
  local -a rendered=()
  for arg in "$@"; do
    redacted="$(redact_start_arg "$arg")"
    printf -v shell_arg '%q' "$redacted"
    rendered+=("$shell_arg")
  done
  local IFS=' '
  printf '%s' "${rendered[*]}"
}

# Match only the Vite process owned by this smoke's H5 root and exact port.
# Arguments are inspected as an argv vector, never reparsed as shell text.
vite_argv_matches_run() {
  local root="$1" port="$2" arg previous=""
  local found_vite=0 found_port=0
  shift 2
  for arg in "$@"; do
    case "$arg" in
      "$root/node_modules/.bin/vite"|"$root/node_modules/vite/bin/vite.js") found_vite=1 ;;
    esac
    if [[ "$previous" == "--port" && "$arg" == "$port" ]]; then
      found_port=1
    fi
    [[ "$arg" == "--port=$port" ]] && found_port=1
    previous="$arg"
  done
  [[ "$found_vite" == "1" && "$found_port" == "1" ]]
}

cleanup_h5_vite() {
  local pid proc
  local -a argv=()
  while IFS= read -r pid; do
    proc="/proc/$pid/cmdline"
    [[ -r "$proc" ]] || continue
    argv=()
    mapfile -d '' -t argv <"$proc" || true
    if vite_argv_matches_run "$H5_ROOT" "$H5_PORT" "${argv[@]}"; then
      kill "$pid" 2>/dev/null || true
    fi
  done < <(pgrep -f 'node_modules/.bin/vite' 2>/dev/null || true)
}

# Test-only seam: classify a synthetic Vite argv without starting a process.
if [[ "${SMOKE_H5_PROCESS_MATCH_TEST:-0}" == "1" ]]; then
  if vite_argv_matches_run "${SMOKE_TEST_H5_ROOT:?}" "${SMOKE_TEST_H5_PORT:?}" "$@"; then
    printf 'match\n'
  else
    printf 'no-match\n'
  fi
  exit 0
fi

# Test-only, no-start seam used by scripts/run-authority-vertical-smoke-test.
# All secret values arrive as individual environment variables from that test;
# this branch does not contain or reproduce any real credential.
if [[ "${SMOKE_START_DIAGNOSTIC_TEST:-0}" == "1" ]]; then
  render_start_command \
    "${SMOKE_TEST_EXECUTABLE:-/tmp/farm-gate}" \
    "FRIENDSHIP_SERVICE_MODE=remote_player" \
    "GATEWAY_LISTEN=127.0.0.1:19191" \
    "FARM_ADDR=127.0.0.1:19292" \
    "SHARE_STORE_PREFIX=smoke:test:share" \
    "FARM_REDIS_URL=${SMOKE_TEST_REDIS_URL-}" \
    "${SMOKE_TEST_REDIS_TLS_URL-}" \
    "PERMIT_SECRET=${SMOKE_TEST_PERMIT_SECRET-}" \
    "THEFT_PRF_HMAC_SECRET=${SMOKE_TEST_THEFT_SECRET-}" \
    "DEMO_PLATFORM_TOKEN=${SMOKE_TEST_PLATFORM_TOKEN-}"
  printf '\n'
  exit 0
fi

# The smoke harness deliberately has its own bounded selector. An absent
# variable preserves the frozen local-gate rollback default; an explicitly
# empty or unknown value fails before any service is built or started.
if [[ ${SMOKE_FRIENDSHIP_SERVICE_MODE+x} ]]; then
  SMOKE_FRIENDSHIP_SERVICE_MODE="$SMOKE_FRIENDSHIP_SERVICE_MODE"
else
  SMOKE_FRIENDSHIP_SERVICE_MODE="local_gate"
fi
case "$SMOKE_FRIENDSHIP_SERVICE_MODE" in
  local_gate|remote_shadow|remote_player) ;;
  *)
    echo "invalid SMOKE_FRIENDSHIP_SERVICE_MODE=$SMOKE_FRIENDSHIP_SERVICE_MODE (want local_gate|remote_shadow|remote_player)" >&2
    exit 2
    ;;
esac

# Q1 final: prefer the premerge-A FINAL H5 worktree (candidate b5434a8 + A1B
# trusted clock + player bootstrap refresh). The q1 hardening worktree is an
# intermediate rig pinned at b9f8659 that LACKS those H5 fixes (run13 tested it
# by mistake and regressed at the post-plant seed deduction assertion).
# H5_ROOT env still wins.
H5_ROOT="${H5_ROOT:-$(if [[ -d "$ROOT_DIR/../classic-farm-h5-premerge-a-final-20260806" ]]; then cd "$ROOT_DIR/../classic-farm-h5-premerge-a-final-20260806" && pwd; elif [[ -d "$ROOT_DIR/../classic-farm-h5-q1-authority-smoke-20260806" ]]; then cd "$ROOT_DIR/../classic-farm-h5-q1-authority-smoke-20260806" && pwd; else cd "$ROOT_DIR/../classic-farm-h5-premerge-a-20260806" && pwd; fi)}"
PLAYWRIGHT_CONFIG="${SMOKE_PLAYWRIGHT_CONFIG:-playwright.authority-smoke.config.ts}"
PLAYWRIGHT_TEST="${SMOKE_PLAYWRIGHT_TEST:-}"
CONTROL_DIR="${SMOKE_CONTROL_DIR:-}"
CROP_MATURE_AFTER="${SMOKE_CROP_MATURE_AFTER:-5s}"
H5_PORT="${SMOKE_H5_PORT:-5194}"
if [[ ! "$H5_PORT" =~ ^[0-9]+$ ]] || (( H5_PORT < 1 || H5_PORT > 65535 )); then
  echo "invalid SMOKE_H5_PORT=$H5_PORT (want 1..65535)" >&2
  exit 2
fi
H5_ALLOWED_ORIGINS="${SMOKE_H5_ALLOWED_ORIGINS:-127.0.0.1:$H5_PORT,localhost:$H5_PORT}"
STAMP="${SMOKE_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
# These prefixes are initialized before any early verdict path so every
# manifest, including fail-closed startup evidence, records the exact
# isolated namespaces without falling back to production defaults.
SHARE_PREFIX="smoke:${STAMP}:share"
# Smoke account suffix: epoch seconds, alphanumeric only (gate register requires
# username of 3-24 letters/digits/underscores; timestamps with '-' are invalid).
ACCOUNT_SUFFIX="$(date +%s)"
OUT="${SMOKE_OUT:-$ROOT_DIR/docs/verification/results/authority-vertical-$STAMP}"
BIN="$OUT/bin"
TMP="$OUT/tmp"
HARNESS_HELPER="$ROOT_DIR/scripts/authority-smoke-harness.py"
ROUTE_HORIZON_WITNESS="$OUT/route-horizon.json"
if [[ -v SMOKE_ROUTE_HORIZON_SECONDS ]]; then
  ROUTE_HORIZON_SECONDS="$SMOKE_ROUTE_HORIZON_SECONDS"
else
  ROUTE_HORIZON_SECONDS=3600
fi
mkdir -p "$OUT" "$BIN" "$TMP"

PIDS=()
cleanup() {
  local p
  for p in "${PIDS[@]:-}"; do kill "$p" 2>/dev/null || true; done
  for p in "${PIDS[@]:-}"; do wait "$p" 2>/dev/null || true; done
  # Q1 hardening: clean up children/fallback processes between runs. Vite is
  # restricted to this exact H5 root and port so another page from the same
  # worktree on a different port is never terminated.
  pkill -f "$BIN/farm-svr" 2>/dev/null || true
  pkill -f "$BIN/farm-worker" 2>/dev/null || true
  pkill -f "$BIN/player-svr" 2>/dev/null || true
  pkill -f "$BIN/farm-gate" 2>/dev/null || true
  pkill -f "$BIN/authority-smoke-fixture" 2>/dev/null || true
  pkill -f "$BIN/gate-vertical-e2e" 2>/dev/null || true
  [[ -d "$H5_ROOT" ]] && cleanup_h5_vite
}
trap cleanup EXIT INT TERM

wait_http() {
  local url="$1" deadline=$((SECONDS + ${2:-30}))
  until curl -fsS "$url" >/dev/null 2>&1; do
    (( SECONDS >= deadline )) && { echo "TIMEOUT: $url" >&2; return 1; }
    sleep 0.1
  done
}

wait_tcp() {
  local port="$1" deadline=$((SECONDS + ${2:-30}))
  until (echo >/dev/tcp/127.0.0.1/"$port") 2>/dev/null; do
    (( SECONDS >= deadline )) && { echo "TIMEOUT: tcp:$port" >&2; return 1; }
    sleep 0.1
  done
}

start() {
  local log="$1"; shift
  local diagnostic_command
  diagnostic_command="$(render_start_command "$@")"
  echo "  starting: $diagnostic_command (log: $log)"
  "$@" >"$log" 2>&1 &
  PIDS+=("$!")
}

BACKEND_COMMIT=""
H5_COMMIT=""
BACKEND_DIRTY="false"
H5_DIRTY="false"

verdict() {
  local v="$1" reason="$2"
  python3 -c "
import json,pathlib,time
out=pathlib.Path('$OUT')
manifest={'run_id':out.name,'backend_commit':'${BACKEND_COMMIT:-unknown}','backend_dirty':'${BACKEND_DIRTY}','h5_commit':'${H5_COMMIT:-unknown}','h5_dirty':'${H5_DIRTY}','h5_port':${H5_PORT},'mode':'authority','worker_mode':'real_authority','assignment_source':'static','legacy_fallback':False,'friendship_service_mode':'${SMOKE_FRIENDSHIP_SERVICE_MODE}','share_store_prefix':'${SHARE_PREFIX}','witness':{'downlink_events':'protocol-events.ndjson','h5_bot_frames':'bot-frames.ndjson','playwright':'playwright.log','authority_after':'authority-after.json'},'finished_at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())}
(out/'run-manifest.json').write_text(json.dumps(manifest,indent=2))
(out/'verdict.json').write_text(json.dumps({'verdict':'$v','reason':'$reason'},indent=2))
"
  echo "$v: $reason"
  echo "evidence: $OUT"
  if [[ "$v" == "PASS" ]]; then exit 0; elif [[ "$v" == "FAIL" ]]; then exit 1; else exit 2; fi
}

cd "$ROOT_DIR"

# --- 1. Freeze candidates ----------------------------------------------------
echo "=== 1. freeze candidates ==="
BACKEND_COMMIT="$(git rev-parse HEAD)"
H5_COMMIT="$(git -C "$H5_ROOT" rev-parse HEAD 2>/dev/null || echo 'unknown')"
# REVIEW P2-5:manifest 必须反映实际运行的代码(HEAD + 未提交脏改动)。
# evidence 目录(docs/verification/results)与 H5 的 test-results/dist 是每轮累积
# 的测试产物,不是代码真值;不应让上一轮遗留证据把 repo 标 dirty(否则连续验收
# 永远 dirty,掩盖真实代码状态)。代码改动(git status 中非 evidence 路径)仍标 dirty。
BACKEND_DIRTY="false"
if [[ -n "$(git status --porcelain | grep -vE '^.. docs/verification/results/' || true)" ]]; then BACKEND_DIRTY="true"; fi
H5_DIRTY="false"
if [[ -n "$(git -C "$H5_ROOT" status --porcelain 2>/dev/null | grep -vE '^.. test-results/|^.. dist/' || true)" ]]; then H5_DIRTY="true"; fi
echo "  backend: $BACKEND_COMMIT (dirty=$BACKEND_DIRTY)"
echo "  h5:      $H5_COMMIT (dirty=$H5_DIRTY)"
if [[ ! -f "$HARNESS_HELPER" ]]; then
  verdict INCONCLUSIVE "missing authority smoke harness helper: $HARNESS_HELPER"
fi

# --- 2. Build ----------------------------------------------------------------
echo "=== 2. build ==="
GOCACHE="${FARM_GO_BUILD_CACHE:-/tmp/farmgame-go-cache}"
for svc in player-svr farm-svr farm-worker farm-gate authority-smoke-fixture gate-vertical-e2e authority-smoke-bot; do
  echo "  building $svc"
  (cd "$ROOT_DIR" && GOCACHE="$GOCACHE" CGO_ENABLED=0 go build -buildvcs=false -trimpath -o "$BIN/$svc" "./cmd/$svc")
done

# --- 3. Redis config ----------------------------------------------------------
echo "=== 3. redis ==="
REDIS_CONFIG="${FARM_REDIS_CONFIG:-$ROOT_DIR/deploy/secrets/redis.conf.local}"
if [[ ! -f "$REDIS_CONFIG" ]]; then
  verdict INCONCLUSIVE "missing Redis config: $REDIS_CONFIG"
fi

read_config_value() {
  sed -n -E "s/^[[:space:]]*$1:[[:space:]]*(.*[^[:space:]])[[:space:]]*$/\1/p" "$REDIS_CONFIG" | head -n 1
}
uri_encode() {
  local input="$1" output="" char encoded index
  LC_ALL=C
  for ((index = 0; index < ${#input}; index++)); do
    char="${input:index:1}"
    case "$char" in [a-zA-Z0-9.~_-]) output+="$char" ;; *) printf -v encoded '%%%02X' "'$char"; output+="$encoded" ;; esac
  done
  printf '%s' "$output"
}
redis_host=$(read_config_value host)
redis_port=$(read_config_value port)
redis_password=$(read_config_value password)
redis_db=$(read_config_value db); redis_db="${redis_db:-0}"
REDIS_URL="redis://:$(uri_encode "$redis_password")@${redis_host}:${redis_port}/${redis_db}"
echo "  redis: ${redis_host}:${redis_port}/${redis_db}"

# --- 4. Ports and namespace ----------------------------------------------------
PORT_COUNT=10
PORT_OUTPUT=""
if ! PORT_OUTPUT="$(python3 "$HARNESS_HELPER" allocate-ports --count "$PORT_COUNT")"; then
  verdict INCONCLUSIVE "INCONCLUSIVE_ENVIRONMENT: bounded endpoint port allocation failed"
fi
mapfile -t ENDPOINT_PORTS <<<"$PORT_OUTPUT"
if [[ "${#ENDPOINT_PORTS[@]}" -ne "$PORT_COUNT" ]]; then
  verdict INCONCLUSIVE "INCONCLUSIVE_ENVIRONMENT: endpoint port count mismatch"
fi
declare -A SEEN_ENDPOINT_PORTS=()
for port in "${ENDPOINT_PORTS[@]}"; do
  if [[ ! "$port" =~ ^[0-9]+$ ]] || (( 10#$port < 1024 || 10#$port > 65535 )); then
    verdict INCONCLUSIVE "INCONCLUSIVE_ENVIRONMENT: invalid endpoint port allocation"
  fi
  if [[ -n "${SEEN_ENDPOINT_PORTS[$port]:-}" ]]; then
    verdict INCONCLUSIVE "INCONCLUSIVE_ENVIRONMENT: duplicate endpoint port allocation"
  fi
  SEEN_ENDPOINT_PORTS[$port]=1
done
PLAYER_PORT="${ENDPOINT_PORTS[0]}"; PLAYER_HEALTH="${ENDPOINT_PORTS[1]}"
FARM_PORT="${ENDPOINT_PORTS[2]}"; FARM_HEALTH="${ENDPOINT_PORTS[3]}"
WORKER_HEALTH="${ENDPOINT_PORTS[4]}"
GATE_HTTP="${ENDPOINT_PORTS[5]}"; GATE_DOWNLINK_REAL="${ENDPOINT_PORTS[6]}"
GATE_CONTROL="${ENDPOINT_PORTS[7]}"
DOWNLINK_PROXY="${ENDPOINT_PORTS[8]}"; PROXY_ADMIN="${ENDPOINT_PORTS[9]}"
unset PORT_OUTPUT ENDPOINT_PORTS SEEN_ENDPOINT_PORTS

NAMESPACE="smoke-${STAMP,,}"
PROFILE="redis-physical-v1"
REALM="smoke-authority"
PLAYER_HOLDER="smoke-player"; FARM_HOLDER="smoke-farm"
PLAYER_BOOT="smoke-player-${STAMP}"; FARM_BOOT="smoke-farm-${STAMP}"
ROUTE="$OUT/route-snapshot.json"
PERMIT_SECRET="smoke-permit-${STAMP}-at-least-32-bytes!!"
WORKFLOW_PREFIX="smoke:${STAMP}:workflow"
echo "  FriendshipService mode: $SMOKE_FRIENDSHIP_SERVICE_MODE"
echo "  isolated Share prefix:  $SHARE_PREFIX"

# --- 5. Fixture init: Claim ShardWriteAuthority --------------------------------
echo "=== 5. fixture init ==="
"$BIN/authority-smoke-fixture" init \
  --redis-url "$REDIS_URL" \
  --namespace "$NAMESPACE" --zone local \
  --profile "$PROFILE" --realm "$REALM" \
  --run-id "$STAMP" \
  --player-holder "$PLAYER_HOLDER" --player-boot "$PLAYER_BOOT" \
  --player-endpoint "127.0.0.1:$PLAYER_PORT" \
  --farm-holder "$FARM_HOLDER" --farm-boot "$FARM_BOOT" \
  --farm-endpoint "127.0.0.1:$FARM_PORT" \
  --route-out "$ROUTE" \
  --json-out "$OUT/fixture.json" 2>&1

# The fixture's Redis ShardAuthority lease is intentionally renewed by the
# services on its existing 55s cadence. Its separate static route snapshot is
# immutable after startup, so give only that test input one bounded horizon
# before any service loads it. The helper validates the complete Player/Farm
# route shape and changes only lease_expire_at_ms.
ROUTE_DEADLINE_MS=""
if ! ROUTE_DEADLINE_MS="$(python3 "$HARNESS_HELPER" refresh-route \
  --route "$ROUTE" \
  --witness "$ROUTE_HORIZON_WITNESS" \
  --horizon-seconds "$ROUTE_HORIZON_SECONDS")"; then
  verdict INCONCLUSIVE "INCONCLUSIVE_TEST_HARNESS: static route horizon refresh rejected"
fi
if [[ ! "$ROUTE_DEADLINE_MS" =~ ^[0-9]+$ ]]; then
  verdict INCONCLUSIVE "INCONCLUSIVE_TEST_HARNESS: invalid static route deadline output"
fi
echo "  test-only route horizon: ${ROUTE_HORIZON_SECONDS}s (deadline_ms=$ROUTE_DEADLINE_MS)"

COMMON_AUTH=(
  "ACTOR_AUTHORITY_MODE=authority"
  "ACTOR_ROUTE_SNAPSHOT=$ROUTE"
  "ACTOR_AUTHORITY_LEASE_TTL=55s"
  "ACTOR_AUTHORITY_LEASE_SAFETY_MARGIN=3s"
  "ACTOR_AUTHORITY_LEASE_RENEW_INTERVAL=5s"
  "REDIS_PHYSICAL_PROFILE_VERSION=$PROFILE"
  "REDIS_NAMESPACE_ENVIRONMENT=$NAMESPACE"
  "REDIS_NAMESPACE_ZONE=local"
  "REDIS_AUTHORITY_LAYOUT_VERSION=v1"
  "REDIS_WORKFLOW_LAYOUT_VERSION=v1"
  "REDIS_WORKFLOW_HASH_VERSION=1"
  "REDIS_WORKFLOW_BUCKET_COUNT=256"
  "FARM_REDIS_URL=$REDIS_URL"
  "WORKFLOW_STORE_PREFIX=$WORKFLOW_PREFIX"
)

# --- 6. Start services ----------------------------------------------------------
echo "=== 6. start services ==="

# Gate first (proxy connects to it). Keep the exact argv in an array so the
# optional CP-B restart hook can only restart this fixed service command; no
# marker content is ever evaluated as shell input.
GATE_CMD=(env
  "GATEWAY_LISTEN=127.0.0.1:$GATE_HTTP"
  "GATEWAY_ID=authority-smoke-gate"
  "FARM_APP_PROFILE=test"
  "GATEWAY_DOWNLINK_LISTEN=127.0.0.1:$GATE_DOWNLINK_REAL"
  "GATE_CONTROL_LISTEN=127.0.0.1:$GATE_CONTROL"
  "GATE_TRANSPORT=websocket" "GATE_WS_PATH=/ws"
  "GATE_WS_ALLOWED_ORIGINS=$H5_ALLOWED_ORIGINS"
  "PLAYER_ADDR=127.0.0.1:$PLAYER_PORT"
  "FARM_ADDR=127.0.0.1:$FARM_PORT"
  "LOGIC_HEALTH_ADDR=http://127.0.0.1:$FARM_HEALTH"
  "FARM_REDIS_URL=$REDIS_URL"
  "REDIS_NAMESPACE_ENVIRONMENT=smoke-${STAMP}"
  "REDIS_NAMESPACE_ZONE=local"
  "FRIENDSHIP_SERVICE_MODE=$SMOKE_FRIENDSHIP_SERVICE_MODE"
  "SHARE_STORE_PREFIX=$SHARE_PREFIX"
  "WEB_ACCOUNT_STORE_PREFIX=smoke:${STAMP}:web-account"
  "WEB_ACCOUNT_PLAYER_ID_BASE=1000000"
  "DEMO_PLATFORM_TOKEN=demo-platform-token"
  "DEMO_PLAYER_ID=10001"
  "DEMO_SECONDARY_PLATFORM_TOKEN=demo-platform-token-b"
  "DEMO_SECONDARY_PLAYER_ID=10002"
  "HTTP_SESSION_TTL=2h"
  "HTTP_SESSION_COOKIE_SECURE=0"
  "PERMIT_SECRET=$PERMIT_SECRET"
  "GATEWAY_TICKET_TTL=60s"
  "GATE_ROUTE_LEASE_TTL=30s"
  "GATE_BOOT_LEASE_PREFIX=smoke:${STAMP}:gate-boot-lease"
  "GATE_BOOT_LEASE_TTL=15s"
  "GATE_BOOT_LEASE_RENEW_TIMEOUT=3s"
  "INITIAL_RULE_VERSION=1"
  "GATE_WS_METRICS=1"
  "GATE_WS_RATE_PER_SEC=100"
  "GATE_WS_RATE_BURST=200"
  "GATE_E2E_COMMAND_RESULT_FAULTS=${SMOKE_E2E_COMMAND_RESULT_FAULTS:-0}"
  "WSS_ENDPOINT=ws://127.0.0.1:$GATE_HTTP/ws"
  "$BIN/farm-gate")
start "$OUT/gate.log" "${GATE_CMD[@]}"
GATE_PID="${PIDS[${#PIDS[@]}-1]}"

# Downlink proxy between farm-svr and Gate.
start "$OUT/proxy.log" "$BIN/gate-vertical-e2e" proxy \
  --listen "127.0.0.1:$DOWNLINK_PROXY" \
  --upstream "127.0.0.1:$GATE_DOWNLINK_REAL" \
  --admin-listen "127.0.0.1:$PROXY_ADMIN" \
  --events-out "$OUT/protocol-events.ndjson"

# player-svr (authority).
start "$OUT/player.log" env "${COMMON_AUTH[@]}" \
  "ACTOR_HOLDER_POD=$PLAYER_HOLDER" "ACTOR_HOLDER_BOOT_ID=$PLAYER_BOOT" \
  "PLAYER_LISTEN=127.0.0.1:$PLAYER_PORT" \
  "PLAYER_HEALTH_LISTEN=127.0.0.1:$PLAYER_HEALTH" \
  "FARM_ADDR=127.0.0.1:$FARM_PORT" \
  "SHARE_STORE_PREFIX=$SHARE_PREFIX" \
  "PERMIT_SECRET=$PERMIT_SECRET" \
  "$BIN/player-svr"

# farm-svr (authority, downlink via proxy).
start "$OUT/farm.log" env "${COMMON_AUTH[@]}" \
  "ACTOR_HOLDER_POD=$FARM_HOLDER" "ACTOR_HOLDER_BOOT_ID=$FARM_BOOT" \
  "FARM_LISTEN=127.0.0.1:$FARM_PORT" \
  "FARM_HEALTH_LISTEN=127.0.0.1:$FARM_HEALTH" \
  "PLAYER_ADDR=127.0.0.1:$PLAYER_PORT" \
  "GATEWAY_DOWNLINK_ADDR=127.0.0.1:$DOWNLINK_PROXY" \
  "PERMIT_SECRET=$PERMIT_SECRET" \
  "THEFT_PRF_MODE=test" \
  "THEFT_PRF_HMAC_SECRET=smoke-theft-prf-${STAMP}-at-least-32-bytes" \
  "FARM_CROP_MATURE_AFTER=$CROP_MATURE_AFTER" \
  "FARM_SUBSCRIPTION_LEASE_INITIAL_TTL=30s" \
  "FARM_SUBSCRIPTION_LEASE_MAX_EXTENSION=30s" \
  "GATE_BOOT_REAPER_MODE=disabled" \
  "$BIN/farm-svr"

# farm-worker (real participant executor, authority mode; Q1: the worker
# consumes ACTOR_AUTHORITY_MODE via permitsecret, so it must be 'authority' —
# 'legacy' would fail the S0 "no legacy fallback" gate).
start "$OUT/worker.log" env \
  "ACTOR_AUTHORITY_MODE=authority" \
  "ACTOR_ROUTE_SNAPSHOT=$ROUTE" \
  "FARM_REDIS_URL=$REDIS_URL" \
  "WORKFLOW_STORE_PREFIX=$WORKFLOW_PREFIX" \
  "REDIS_PHYSICAL_PROFILE_VERSION=$PROFILE" \
  "REDIS_NAMESPACE_ENVIRONMENT=$NAMESPACE" \
  "REDIS_NAMESPACE_ZONE=local" \
  "REDIS_AUTHORITY_LAYOUT_VERSION=v1" \
  "REDIS_WORKFLOW_LAYOUT_VERSION=v1" \
  "REDIS_WORKFLOW_HASH_VERSION=1" \
  "REDIS_WORKFLOW_BUCKET_COUNT=256" \
  "PLAYER_ADDR=127.0.0.1:$PLAYER_PORT" \
  "FARM_ADDR=127.0.0.1:$FARM_PORT" \
  "WORKER_ID=smoke-worker" \
  "WORKER_BOOT_ID=smoke-worker-$STAMP" \
  "WORKER_LEASE_TOKEN=smoke-lease-$STAMP" \
  "WORKER_POLL_INTERVAL=100ms" \
  "WORKER_CLAIM_LIMIT=8" \
  "WORKER_CLAIM_LEASE=5s" \
  "WORKER_OPERATION_TIMEOUT=3s" \
  "WORKER_PARTICIPANT_BUDGET_MS=5000" \
  "WORKER_HEALTH_LISTEN=127.0.0.1:$WORKER_HEALTH" \
  "$BIN/farm-worker"

# --- 7. Wait ready ---------------------------------------------------------------
echo "=== 7. wait ready ==="
wait_http "http://127.0.0.1:$PLAYER_HEALTH/readyz" 30 || verdict INCONCLUSIVE "player-svr not ready"
echo "  player-svr ready"
wait_http "http://127.0.0.1:$FARM_HEALTH/readyz" 30 || verdict INCONCLUSIVE "farm-svr not ready"
echo "  farm-svr ready"
wait_http "http://127.0.0.1:$WORKER_HEALTH/readyz" 30 || verdict INCONCLUSIVE "farm-worker not ready"
echo "  farm-worker ready"
wait_tcp "$GATE_HTTP" 30 || verdict INCONCLUSIVE "farm-gate not ready"
echo "  farm-gate ready"

# Optional fixed-function test control. Only two filenames are recognized;
# request content is ignored and never evaluated. This lets headed Playwright
# prove cookie/WSS recovery across one real farm-gate process restart.
restart_gate_watcher() {
  local restart_seq=0 request ack next_pid deadline old_pid
  mkdir -p "$CONTROL_DIR"
  request="$CONTROL_DIR/restart-gate.request"
  ack="$CONTROL_DIR/restart-gate.ack.json"
  rm -f "$request" "$ack"
  # This watcher is a background subshell and cannot wait(2) for the Gate
  # process owned by the parent shell. It nevertheless owns every replacement
  # Gate, so ensure the currently tracked process cannot leak on runner exit.
  trap 'kill "$GATE_PID" 2>/dev/null || true' EXIT
  trap 'exit 0' TERM INT
  while true; do
    if [[ -f "$request" ]]; then
      rm -f "$request" "$ack"
      restart_seq=$((restart_seq + 1))
      echo "  control: restarting farm-gate (sequence=$restart_seq)"
      old_pid="$GATE_PID"
      kill "$old_pid" 2>/dev/null || true
      # Graceful shutdown intentionally drains for five seconds. Waiting on
      # kill -0 is invalid here because the parent-owned process can remain a
      # zombie; instead prove that every listener needed by the replacement is
      # closed before starting it.
      deadline=$((SECONDS + 15))
      while (echo >/dev/tcp/127.0.0.1/"$GATE_HTTP") 2>/dev/null ||
            (echo >/dev/tcp/127.0.0.1/"$GATE_CONTROL") 2>/dev/null ||
            (echo >/dev/tcp/127.0.0.1/"$GATE_DOWNLINK_REAL") 2>/dev/null; do
        if (( SECONDS >= deadline )); then
          kill -KILL "$old_pid" 2>/dev/null || true
          sleep 0.2
          break
        fi
        sleep 0.1
      done
      "${GATE_CMD[@]}" >>"$OUT/gate-restart-$restart_seq.log" 2>&1 &
      next_pid=$!
      GATE_PID="$next_pid"
      deadline=$((SECONDS + 30))
      until kill -0 "$GATE_PID" 2>/dev/null && curl -fsS "http://127.0.0.1:$GATE_HTTP/readyz" >/dev/null 2>&1; do
        if (( SECONDS >= deadline )); then
          printf '{"status":"FAILED","sequence":%d}\n' "$restart_seq" >"$ack.tmp"
          mv "$ack.tmp" "$ack"
          break
        fi
        sleep 0.1
      done
      if [[ ! -f "$ack" ]]; then
        printf '{"status":"READY","sequence":%d,"pid":%d}\n' "$restart_seq" "$GATE_PID" >"$ack.tmp"
        mv "$ack.tmp" "$ack"
      fi
    fi
    sleep 0.1
  done
}
if [[ -n "$CONTROL_DIR" ]]; then
  restart_gate_watcher >"$OUT/control.log" 2>&1 &
  PIDS+=("$!")
  echo "  fixed restart control: $CONTROL_DIR"
fi

# --- 8. Verify authority mode ----------------------------------------------------
echo "=== 8. verify authority mode ==="
if ! grep -q 'authority mode enabled' "$OUT/player.log"; then
  verdict FAIL "player-svr: authority mode not confirmed in logs"
fi
if ! grep -q 'authority mode enabled' "$OUT/farm.log"; then
  verdict FAIL "farm-svr: authority mode not confirmed in logs"
fi
if grep -Eqi 'mode=legacy|legacy fallback|using legacy' "$OUT/player.log" "$OUT/farm.log"; then
  verdict FAIL "legacy fallback observed in logs"
fi
echo "  authority mode confirmed for player-svr and farm-svr"
echo "  no legacy fallback detected"

# --- 9. Independent observers ---------------------------------------------------
# Start S1B before S1A and collect it below. Both are independent real clients;
# running them concurrently keeps the finite static Route lease from becoming
# an accidental function of Playwright video/trace finalization time.
BOT_FAIL=2
BOT_PID=""
if [[ -x "$BIN/authority-smoke-bot" ]]; then
  "$BIN/authority-smoke-bot" \
    --http-url "http://127.0.0.1:$GATE_HTTP" \
    --ws-url "ws://127.0.0.1:$GATE_HTTP/ws" \
    --user "smoke_bot${ACCOUNT_SUFFIX}" \
    --password "smoke123" \
    --json-out "$OUT/protocol-verdict.json" \
    --frames-out "$OUT/bot-frames.ndjson" \
    >"$OUT/bot.log" 2>&1 &
  BOT_PID=$!
  PIDS+=("$BOT_PID")
fi

# S1A: H5 Playwright smoke (real browser; VITE_WS_URL=/ws through vite proxy).
# A failure in either observer must never prevent the other from producing
# evidence (Q1 CONTRACT_ALIGNMENT).
echo "=== 9. S1A: H5 Playwright smoke ==="
PLAYWRIGHT_FAIL=2
if [[ -d "$H5_ROOT" ]]; then
  set +e
  (
    cd "$H5_ROOT"
    # Q1: the client talks to the same-origin /ws, so the Vite dev server /ws
    # proxy is genuinely exercised (VITE_WS_PROXY_TARGET points at farm-gate).
    playwright_args=(test --config "$PLAYWRIGHT_CONFIG" --reporter=line)
    if [[ -n "$PLAYWRIGHT_TEST" ]]; then playwright_args+=("$PLAYWRIGHT_TEST"); fi
    FARM_E2E_API_BASE_URL="http://127.0.0.1:$GATE_HTTP" \
    FARM_E2E_H5_PORT="$H5_PORT" \
    FARM_E2E_WS_PROXY_TARGET="ws://127.0.0.1:$GATE_HTTP" \
    FARM_E2E_WSS_URL="/ws" \
    FARM_E2E_USER_A="smoke_a${ACCOUNT_SUFFIX}" \
    FARM_E2E_USER_B="smoke_b${ACCOUNT_SUFFIX}" \
    FARM_E2E_USER_C="smoke_c${ACCOUNT_SUFFIX}" \
    FARM_E2E_PASSWORD="smoke123" \
    FARM_E2E_CONTROL_DIR="$CONTROL_DIR" \
    FARM_E2E_FAULT_ADMIN_URL="http://127.0.0.1:$PROXY_ADMIN" \
    FARM_E2E_EVIDENCE_ROOT="$OUT" \
    npx playwright "${playwright_args[@]}" \
      >"$OUT/playwright.log" 2>&1
  )
  PLAYWRIGHT_FAIL=$?
  set -e
  echo "  playwright exit: $PLAYWRIGHT_FAIL"
  echo "  playwright log: $OUT/playwright.log"
  tail -25 "$OUT/playwright.log" || true
else
  echo "  H5 root not found: $H5_ROOT (skipping)"
fi

# --- 9b. S1B: real Go WSS protocol bot (independent observer) ---------------------
echo "=== 9b. S1B: Go WSS protocol bot ==="
if [[ -n "$BOT_PID" ]]; then
  set +e
  wait "$BOT_PID"
  BOT_FAIL=$?
  set -e
  echo "  bot exit: $BOT_FAIL"
  echo "  bot verdict: $OUT/protocol-verdict.json"
  grep -E '"(verdict|steps)"|    "(ok|fail|inconclusive)"' "$OUT/protocol-verdict.json" 2>/dev/null | head -20 || tail -20 "$OUT/bot.log"
else
  echo "  authority-smoke-bot not built (skipping)"
fi

# --- 10. Audit -------------------------------------------------------------------
echo "=== 10. authority audit ==="
AUDIT_FAIL=0
set +e
"$BIN/authority-smoke-fixture" audit \
  --redis-url "$REDIS_URL" \
  --namespace "$NAMESPACE" --zone local \
  --route "$ROUTE" \
  --protocol-verdict "$OUT/protocol-verdict.json" \
  --browser-verdict "$OUT/browser-verdict.json" \
  --json-out "$OUT/authority-after.json" 2>&1
AUDIT_FAIL=$?
set -e

if [[ "$AUDIT_FAIL" -ne 0 ]]; then
  verdict INCONCLUSIVE "authority audit failed rc=$AUDIT_FAIL"
fi

# --- 11. Verdict -------------------------------------------------------------------
# Q1 CONTRACT_ALIGNMENT: combined verdict distinguishes
#   PASS                   S0 + S1A(real H5) + S1B(protocol bot) all green
#   H5_FAIL_SERVER_PASS    real H5 failed while the protocol bot passed (H5/UI issue)
#   SERVER_FAIL            protocol bot failed (server/protocol issue)
#   INCONCLUSIVE           tooling missing / S0 or audit not qualified
echo "=== 11. verdict ==="
S0_OK=1
grep -q 'authority mode enabled' "$OUT/player.log" || S0_OK=0
grep -q 'authority mode enabled' "$OUT/farm.log" || S0_OK=0
# authority-after.json 顶层无 verdict(protocol_verdict 是嵌套的 S1B 结果);
# S0 判定依据 ShardWriteAuthority 读取成功(authority 字段存在)。
python3 -c "
import json,sys
try:
    d=json.load(open('$OUT/authority-after.json'))
    ok = 'authority' in d and 'player' in d['authority'] and 'farm' in d['authority']
    if '${SMOKE_REQUIRE_SOCIAL_ORACLE:-0}' == '1':
        ok = ok and d.get('business_oracle',{}).get('verdict') == 'PASS'
    sys.exit(0 if ok else 1)
except Exception:
    sys.exit(1)
" || S0_OK=0
S1_A=${PLAYWRIGHT_FAIL:-2}
S1_B=${BOT_FAIL:-2}
if [[ $S0_OK -eq 1 && "$S1_A" -eq 0 && "$S1_B" -eq 0 ]]; then
  verdict PASS "S0 + S1A(real H5) + S1B(protocol bot) passed"
elif [[ $S0_OK -eq 1 && ( "$S1_A" -eq 2 || "$S1_B" -eq 2 ) ]]; then
  verdict INCONCLUSIVE "S1 tooling missing (h5=$S1_A bot=$S1_B)"
elif [[ $S0_OK -eq 1 && "$S1_B" -ne 0 && "$S1_B" -ne 2 ]]; then
  verdict FAIL "SERVER_FAIL: protocol bot failed (h5=$S1_A bot=$S1_B)"
elif [[ $S0_OK -eq 1 && "$S1_A" -ne 0 && "$S1_A" -ne 2 && "$S1_B" -eq 0 ]]; then
  verdict FAIL "H5_FAIL_SERVER_PASS: real H5 failed while protocol bot passed (h5=$S1_A bot=$S1_B)"
else
  verdict FAIL "S0 or S1 failed (s0=$S0_OK h5=$S1_A bot=$S1_B)"
fi
