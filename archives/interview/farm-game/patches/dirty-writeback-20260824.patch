+// BestEffortConfig is the experiment-only PlayerActor -> FarmActor guard
+// synchronization path. It performs one bounded Coordinator RPC from the
+// immutable in-memory AttachedOrder and never creates/claims a Redis
+// SourceOrder. Route fencing and destination Actor receipts remain enabled.
+type BestEffortConfig struct {
+	Route               RouteProvider
+	Farm                CoordinatorParticipantClient
+	BucketForPlayer     func(uint64) (rediskey.AuthorityBucketRef, error)
+	OperationTimeout    time.Duration
+	ParticipantBudgetMs uint32
+}
+
+type BestEffortDispatcher struct{ config BestEffortConfig }
+
+func NewBestEffortDispatcher(config BestEffortConfig) (*BestEffortDispatcher, error) {
+	if config.Route == nil || config.Farm == nil || config.BucketForPlayer == nil {
+		return nil, fmt.Errorf("%w: best-effort route, Farm client and PLAYER bucket resolver are required", ErrInvalidConfig)
+	}
+	if config.OperationTimeout <= 0 {
+		config.OperationTimeout = defaultOperationTimeout
+	}
+	if config.ParticipantBudgetMs == 0 {
+		config.ParticipantBudgetMs = contracts.ParticipantMaxBudgetMs
+	}
+	return &BestEffortDispatcher{config: config}, nil
+}
+
+func (d *BestEffortDispatcher) Dispatch(ctx context.Context, order authoritystore.AttachedOrder) error {
+	if d == nil || d.config.Route == nil || d.config.Farm == nil || d.config.BucketForPlayer == nil {
+		return fmt.Errorf("%w: best-effort dispatcher is unavailable", ErrInvalidConfig)
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if order.OrderID == "" || order.OrderType != FamilyGuardSync || order.OperationID == "" ||
+		order.SubjectPlayerID == 0 || order.DueAtMs <= 0 || len(order.Payload) == 0 ||
+		order.PayloadHash == (authoritystore.PayloadHash{}) {
+		return fmt.Errorf("%w: best-effort GuardSync order identity", ErrPayloadInvalid)
+	}
+	payload, err := DecodeApplyGuardSnapshotPayload(order.OrderID, order.Payload)
+	if err != nil {
+		return err
+	}
+	if payload.GetSourcePlayerId() != order.SubjectPlayerID ||
+		ApplyGuardSnapshotPayloadHash(order.Payload) != hex.EncodeToString(order.PayloadHash[:]) {
+		return fmt.Errorf("%w: best-effort GuardSync payload binding", ErrPayloadInvalid)
+	}
+	bucket, err := d.config.BucketForPlayer(order.SubjectPlayerID)
+	if err != nil {
+		return err
+	}
+	if err := bucket.Validate(); err != nil || bucket.Domain() != actorrouting.DomainPlayer {
+		return fmt.Errorf("%w: best-effort PLAYER bucket", ErrInvalidConfig)
+	}
+	address, err := guardWorkAddress(bucket, order.OrderID, order.SubjectPlayerID)
+	if err != nil {
+		return err
+	}
+	wire, err := wireGuardWorkAddress(address, bucket.LayoutVersion())
+	if err != nil {
+		return err
+	}
+	invocation, err := identity.ParticipantInvocationID(identity.WorkTypeGuardSyncOrder, order.OrderID, identity.StepApplyGuardSnapshot, 1)
+	if err != nil {
+		return err
+	}
+	opCtx, cancel := context.WithTimeout(ctx, d.config.OperationTimeout)
+	defer cancel()
+	route, err := d.config.Route(opCtx, payload.GetTargetFarmId())
+	if err != nil {
+		return err
+	}
+	request := &contractspb.ParticipantRequest{
+		RouteHeader: route, ParticipantCommand: contractspb.ParticipantCommandType_PARTICIPANT_COMMAND_TYPE_APPLY_GUARD_SNAPSHOT,
+		TypedPayload: append([]byte(nil), order.Payload...),
+		CallerContext: &contractspb.ParticipantRequest_Coordinator{Coordinator: &contractspb.CoordinatorWorkContext{
+			Work: wire, ExpectedWorkVersion: 1, ParticipantStep: contractspb.ParticipantStep_PARTICIPANT_STEP_APPLY_GUARD_SNAPSHOT,
+			ParticipantInvocationId: invocation, OperationId: order.OperationID, SubjectPlayerId: order.SubjectPlayerID,
+			RemainingBudgetMs: d.config.ParticipantBudgetMs,
+		}},
+		BestEffortSourceOrder: &contractspb.CreatedSourceOrderEnvelope{
+			Work: proto.Clone(wire).(*contractspb.WorkAddress), WorkVersion: 1, OperationId: order.OperationID,
+			SubjectPlayerId: order.SubjectPlayerID, TypedPayload: append([]byte(nil), order.Payload...),
+			PayloadHash: append([]byte(nil), order.PayloadHash[:]...), DueAtMs: order.DueAtMs,
+		},
+	}
+	response, err := d.config.Farm.ExecuteStep(opCtx, request)
+	if err != nil {
+		return err
+	}
+	return ValidateTerminalProof(response, order.OrderID, payload)
+}
