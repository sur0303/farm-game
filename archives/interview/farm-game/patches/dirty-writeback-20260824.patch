+// NewRoutedCoordinatorClient selects the current FARM endpoint and rechecks
+// the complete route fence immediately before the best-effort GuardSync RPC.
+// It owns no service discovery; callers provide clients backed by the same
+// local route snapshot/endpoint pool used by normal Actor routing.
+func NewRoutedCoordinatorClient(resolver actorrouting.Resolver, realm string, clients map[string]CoordinatorParticipantClient) (CoordinatorParticipantClient, error) {
+	if resolver == nil || strings.TrimSpace(realm) == "" || len(clients) == 0 {
+		return nil, fmt.Errorf("%w: routed FARM Coordinator client", ErrInvalidConfig)
+	}
+	copyClients := make(map[string]CoordinatorParticipantClient, len(clients))
+	for endpoint, client := range clients {
+		if strings.TrimSpace(endpoint) != "" && client != nil {
+			copyClients[endpoint] = client
+		}
+	}
+	if len(copyClients) == 0 {
+		return nil, fmt.Errorf("%w: routed FARM Coordinator clients are empty", ErrInvalidConfig)
+	}
+	return &routedCoordinatorClient{resolver: resolver, realm: realm, clients: copyClients}, nil
+}
+
+type routedCoordinatorClient struct {
+	resolver actorrouting.Resolver
+	realm    string
+	clients  map[string]CoordinatorParticipantClient
+}
+
+func (c *routedCoordinatorClient) ExecuteStep(ctx context.Context, request *contractspb.ParticipantRequest, options ...grpc.CallOption) (*contractspb.ParticipantResponse, error) {
+	if c == nil || c.resolver == nil || request == nil || request.GetRouteHeader() == nil {
+		return nil, fmt.Errorf("%w: routed Coordinator request", ErrInvalidConfig)
+	}
+	header := request.GetRouteHeader()
+	if header.GetRouteDomain() != logicrpcpb.RouteDomain_ROUTE_DOMAIN_FARM || header.GetActorId() == 0 {
+		return nil, fmt.Errorf("%w: Coordinator route domain", ErrInvalidConfig)
+	}
+	address := actorrouting.Address{Realm: c.realm, Kind: actorrouting.DomainFarm, ID: header.GetActorId()}
+	assignment, err := c.resolver.Resolve(ctx, address)
+	if err != nil {
+		return nil, err
+	}
+	if !sameAssignment(header, assignment) {
+		return nil, fmt.Errorf("%w: stale FARM route", actorrouting.ErrStaleRoute)
+	}
+	client := c.clients[assignment.Endpoint]
+	if client == nil {
+		return nil, fmt.Errorf("%w: FARM endpoint %s", actorrouting.ErrNoAssignment, assignment.Endpoint)
+	}
+	return client.ExecuteStep(actorrouting.WithRoute(ctx, address, assignment), request, options...)
+}
