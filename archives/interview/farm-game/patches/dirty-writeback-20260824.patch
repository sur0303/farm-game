+// flushSoftActor freezes state and installs completion in system turns, while
+// the Redis call itself runs outside the farm mailbox.
+func (r *Registry) flushSoftActor(ctx context.Context, farmID uint64) error {
+	if r == nil || r.exec == nil || farmID == 0 {
+		return errors.New("farm actor: dirty writeback unavailable")
+	}
+	var preparedActor *FarmActor
+	var preparedBinding *authority.Binding
+	var attempt *authority.SoftFlushAttempt
+	_, err := r.exec.SubmitSystem(ctx, farmID, actorruntime.SystemKindPersistenceCompleted, func(ctx context.Context) (any, error) {
+		release, err := r.acquireAuthorityCoord(ctx, farmID)
+		if err != nil {
+			return nil, err
+		}
+		defer release()
+		r.mu.Lock()
+		actor := r.actors[farmID]
+		r.mu.Unlock()
+		binding := authorityBindingForFarmActor(actor)
+		if binding == nil || !binding.SoftDirty() {
+			return nil, nil
+		}
+		preparedActor, preparedBinding = actor, binding
+		attempt, _, err = binding.PrepareSoftFlush(farmID)
+		return nil, err
+	})
+	if err != nil || attempt == nil {
+		return err
+	}
+	execution := attempt.Execute(ctx)
+	completionCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	completionRan := false
+	_, completionErr := r.exec.SubmitSystem(completionCtx, farmID, actorruntime.SystemKindPersistenceCompleted, func(ctx context.Context) (any, error) {
+		completionRan = true
+		release, err := r.acquireAuthorityCoord(ctx, farmID)
+		if err != nil {
+			return nil, err
+		}
+		defer release()
+		r.mu.Lock()
+		currentActor := r.actors[farmID]
+		r.mu.Unlock()
+		currentBinding := authorityBindingForFarmActor(currentActor)
+		if currentActor != preparedActor || currentBinding != preparedBinding {
+			_ = preparedBinding.AbortSoftFlush(attempt)
+			return nil, blobstore.ErrWriterEpochMismatch
+		}
+		_, err = currentBinding.CompleteSoftFlush(attempt, execution)
+		if errors.Is(err, blobstore.ErrWriterEpochMismatch) {
+			_ = r.evictFencedContext(ctx, farmID, currentActor)
+		}
+		return nil, err
+	})
+	if completionErr != nil && !completionRan {
+		abortErr := preparedBinding.AbortSoftFlush(attempt)
+		return errors.Join(completionErr, abortErr)
+	}
+	return completionErr
+}
