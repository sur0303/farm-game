{
  "apiVersion": "v1",
  "kind": "Secret",
  "metadata": {
    "name": "farm-staging-secrets",
    "annotations": {
      "farm.io/secret-template": "external-secret-manager-required",
      "farm.io/do-not-commit-values": "true"
    },
    "labels": {
      "app.kubernetes.io/part-of": "farm-game"
    }
  },
  "type": "Opaque",
  "stringData": {
    "redis-url": "REPLACE_FROM_CONTROLLED_REDIS_SECRET_MANAGER",
    "redis-cluster-urls": "REPLACE_WITH_COMMA_SEPARATED_REDIS_CLUSTER_SEEDS",
    "permit-secret": "REPLACE_FROM_SECRET_MANAGER_MIN_32_BYTES",
    "http-session-cookie-keyring": "REPLACE_FROM_SECRET_MANAGER_VERSIONED_KEYRING",
    "web-login-rate-limit-secret": "REPLACE_FROM_SECRET_MANAGER_MIN_32_BYTES",
    "theft-prf-hmac-secret": "REPLACE_FROM_SECRET_MANAGER_MIN_32_BYTES",
    "load-test-token-secret": "REPLACE_FROM_ISOLATED_LOAD_SECRET_MANAGER"
  }
}
