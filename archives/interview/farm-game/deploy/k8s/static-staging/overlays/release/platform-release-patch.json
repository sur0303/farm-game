{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "farm-staging-platform"
  },
  "data": {
    "FRIENDSHIP_SERVICE_MODE": "remote_player",
    "FRIENDSHIP_RPC_TIMEOUT": "2s",
    "FRIENDSHIP_SHADOW_EVIDENCE_SHA256": "REPLACE_WITH_64_HEX_ZERO_UNEXPLAINED_SHADOW_EVIDENCE",
    "FRIENDSHIP_SHADOW_EVIDENCE_REVIEWED": "REPLACE_WITH_TRUE_AFTER_REVIEW",
    "FRIENDSHIP_SHADOW_EVIDENCE_SCOPE": "zero-unexplained-shadow-v1",
    "FRIENDSHIP_SHADOW_EVIDENCE_REF": "REPLACE_WITH_REVIEWED_SHADOW_EVIDENCE_REF",
    "H5_PUBLIC_HOST": "REPLACE_WITH_FORMAL_STAGING_HOST",
    "H5_PUBLIC_ORIGIN": "https://REPLACE_WITH_FORMAL_STAGING_HOST",
    "H5_PUBLIC_WSS": "wss://REPLACE_WITH_FORMAL_STAGING_HOST/ws",
    "GATE_WS_ALLOWED_ORIGINS": "REPLACE_WITH_FORMAL_STAGING_HOST",
    "GATE_WS_TRUSTED_PROXIES": "REPLACE_WITH_H5_PROXY_CIDR",
    "GATE_HTTP_TRUSTED_PROXIES": "REPLACE_WITH_H5_PROXY_CIDR",
    "WSS_ENDPOINT": "wss://REPLACE_WITH_FORMAL_STAGING_HOST/ws"
  }
}
