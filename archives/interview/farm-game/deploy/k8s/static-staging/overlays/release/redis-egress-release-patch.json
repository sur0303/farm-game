{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "farm-redis-egress-controlled-cidr"
  },
  "spec": {
    "egress": [
      {
        "to": [
          {
            "ipBlock": {
              "cidr": "REPLACE_WITH_CONTROLLED_REDIS_CIDR"
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 6379
          }
        ]
      }
    ]
  }
}
