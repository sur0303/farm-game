{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "farm-redis-egress-controlled-cidr"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "farm.io/redis-client": "true"
      }
    },
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "to": [
          {
            "ipBlock": {
              "cidr": "192.0.2.0/24"
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 6379
          }
        ]
      }
    ]
  }
}
