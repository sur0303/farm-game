{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "ServiceMonitor",
  "metadata": {
    "name": "farm-svr",
    "labels": {
      "app.kubernetes.io/part-of": "farm-game",
      "farm.io/monitoring-profile": "staging-v1"
    }
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "farm-svr"
      }
    },
    "endpoints": [
      {
        "port": "health",
        "path": "/metrics",
        "interval": "15s",
        "scrapeTimeout": "5s"
      }
    ]
  }
}
